<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import GUI from 'three/addons/libs/lil-gui.module.min.js';

/* =====================================================================
   1.  PARAMÈTRES (Table 1 de l'article)
   ===================================================================== */
const MAX_N = 500;
const TAU   = 0.1;                 // τ : pas de temps (s)
const DEG   = Math.PI / 180;

const P = {
  N: 100,          // nombre d'individus
  rr: 1,           // r_r : rayon de la zone de répulsion
  dro: 3.5,        // Δr_o = r_o − r_r
  dra: 9.5,        // Δr_a = r_a − r_o
  alpha: 270,      // α : champ de perception (degrés)
  theta: 40,       // θ : taux de rotation (degrés / s)
  speed: 3,        // s : vitesse (unités / s)
  sigma: 0.05,     // σ : écart-type de l'erreur (rad)

  timeScale: 4, paused: false, resetOnPreset: true,
  varParam: 'none', varSd: 0,
  colorMode: 'direction', size: 1.2, showZones: false, follow: true,
  sweepSteps: 2000,
};

/* =====================================================================
   2.  ÉTAT DE LA SIMULATION
   ===================================================================== */
const pos     = new Float64Array(3 * MAX_N);   // c_i(t)
const dir     = new Float64Array(3 * MAX_N);   // v_i(t)  (unitaire)
const prevPos = new Float64Array(3 * MAX_N);   // pour l'interpolation du rendu
const prevDir = new Float64Array(3 * MAX_N);
const des     = new Float64Array(3 * MAX_N);   // d_i(t+τ)

// paramètres individuels (permettent la variation inter-individuelle, section « self-sorting »)
const S   = new Float64Array(MAX_N);   // vitesse
const TH  = new Float64Array(MAX_N);   // taux de rotation (rad/s)
const SIG = new Float64Array(MAX_N);   // erreur (rad)
const RR  = new Float64Array(MAX_N);
const RO  = new Float64Array(MAX_N);
const RA  = new Float64Array(MAX_N);
const Z   = new Float64Array(MAX_N);   // déviation gaussienne standard fixe par individu

const zoneState = new Uint8Array(MAX_N);  // 0 aucun voisin, 1 répulsion, 2 orientation, 3 attraction, 4 orientation+attraction
const parent    = new Int32Array(MAX_N);  // union-find (fragmentation)
const compSize  = new Int32Array(MAX_N);
const inMain    = new Uint8Array(MAX_N);

let stepCount = 0, pGroup = 0, mGroup = 0, nGroups = 1, mainSize = P.N;
let snapCam = true;

const HN = 1500;
const histP = new Float32Array(HN), histM = new Float32Array(HN);
let histHead = 0, histCount = 0;

function gauss() {                       // Box–Muller
  let u = 0; while (u === 0) u = Math.random();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * Math.random());
}
function randUnit(out, k) {              // direction uniforme sur la sphère
  const z = 2 * Math.random() - 1, a = 2 * Math.PI * Math.random(), r = Math.sqrt(1 - z * z);
  out[k] = r * Math.cos(a); out[k + 1] = r * Math.sin(a); out[k + 2] = z;
}

function applyParams() {
  const ro0 = P.rr + P.dro, ra0 = ro0 + P.dra, v = P.varParam;
  for (let i = 0; i < MAX_N; i++) {
    const z = Z[i] * P.varSd;
    S[i]   = Math.max(0,    P.speed + (v === 's'     ? z : 0));
    TH[i]  = Math.max(0,    P.theta + (v === 'theta' ? z : 0)) * DEG;
    SIG[i] = Math.max(0,    P.sigma + (v === 'sigma' ? z : 0));
    RR[i]  = Math.max(0.01, P.rr    + (v === 'rr'    ? z : 0));
    RO[i]  = Math.max(RR[i], ro0    + (v === 'ro'    ? z : 0));
    RA[i]  = Math.max(RO[i], ra0    + (v === 'ra'    ? z : 0));
  }
}

function reset() {
  // positions aléatoires dans une sphère, orientations aléatoires
  const R = 1.5 * Math.cbrt(P.N) * P.rr;
  for (let i = 0; i < MAX_N; i++) {
    const k = 3 * i;
    randUnit(pos, k);
    const r = R * Math.cbrt(Math.random());
    pos[k] *= r; pos[k + 1] *= r; pos[k + 2] *= r;
    randUnit(dir, k);
    Z[i] = gauss();
    zoneState[i] = 0;
  }
  prevPos.set(pos); prevDir.set(dir);
  inMain.fill(1);
  stepCount = 0; histHead = 0; histCount = 0;
  nGroups = 1; mainSize = P.N;
  applyParams();
  computeMetrics(false);
  snapCam = true;
}

function find(a) { while (parent[a] !== a) { parent[a] = parent[parent[a]]; a = parent[a]; } return a; }
function union(a, b) { a = find(a); b = find(b); if (a !== b) parent[b] = a; }

/* =====================================================================
   3.  UN PAS DE TEMPS DU MODÈLE
   ===================================================================== */
function step() {
  const N = P.N;
  prevPos.set(pos); prevDir.set(dir);
  // voisin j détectable si l'angle entre v_i et r_ij est ≤ α/2
  const cosHalf = P.alpha >= 360 ? -2 : Math.cos(0.5 * P.alpha * DEG);
  for (let i = 0; i < N; i++) parent[i] = i;

  // ---- (a) direction désirée d_i(t+τ) pour chaque individu (mise à jour synchrone)
  for (let i = 0; i < N; i++) {
    const i3 = 3 * i;
    const px = pos[i3], py = pos[i3 + 1], pz = pos[i3 + 2];
    const vx = dir[i3], vy = dir[i3 + 1], vz = dir[i3 + 2];
    const rr = RR[i], ro = RO[i], ra = RA[i], ra2 = ra * ra;

    let rx = 0, ry = 0, rz = 0, nr = 0;   // d_r
    let ox = 0, oy = 0, oz = 0, no = 0;   // d_o
    let ax = 0, ay = 0, az = 0, na = 0;   // d_a

    for (let j = 0; j < N; j++) {
      if (j === i) continue;
      const j3 = 3 * j;
      const dx = pos[j3] - px, dy = pos[j3 + 1] - py, dz = pos[j3 + 2] - pz;
      const d2 = dx * dx + dy * dy + dz * dz;
      if (d2 > ra2) continue;
      const d = Math.sqrt(d2);

      // Zone de répulsion : sphère complète (pas de volume aveugle) — éq. (1)
      if (d < rr) {
        if (d > 1e-12) { const inv = 1 / d; rx -= dx * inv; ry -= dy * inv; rz -= dz * inv; }
        nr++; union(i, j);
        continue;
      }
      // Volume aveugle : cône arrière d'angle (360 − α)°
      if (dx * vx + dy * vy + dz * vz < cosHalf * d) continue;
      union(i, j);
      if (nr > 0) continue;               // la répulsion est prioritaire

      if (d < ro) {                       // zone d'orientation : r_r ≤ d < r_o — éq. (2)
        ox += dir[j3]; oy += dir[j3 + 1]; oz += dir[j3 + 2]; no++;
      } else {                            // zone d'attraction : r_o ≤ d ≤ r_a — éq. (3)
        const inv = 1 / d; ax += dx * inv; ay += dy * inv; az += dz * inv; na++;
      }
    }

    let ex, ey, ez, zs;
    if (nr > 0)                 { ex = rx; ey = ry; ez = rz; zs = 1; }                       // d_i = d_r
    else if (no > 0 && na > 0)  { ex = 0.5 * (ox + ax); ey = 0.5 * (oy + ay); ez = 0.5 * (oz + az); zs = 4; } // ½(d_o + d_a)
    else if (no > 0)            { ex = ox; ey = oy; ez = oz; zs = 2; }                       // d_i = d_o
    else if (na > 0)            { ex = ax; ey = ay; ez = az; zs = 3; }                       // d_i = d_a
    else                        { ex = vx; ey = vy; ez = vz; zs = 0; }                       // aucun voisin : d_i = v_i

    let len = Math.sqrt(ex * ex + ey * ey + ez * ez);
    if (len < 1e-9) { ex = vx; ey = vy; ez = vz; }      // vecteur nul : d_i = v_i
    else { len = 1 / len; ex *= len; ey *= len; ez *= len; }

    // Erreur : rotation de d_i d'un angle gaussien (écart-type σ) autour d'un axe ⟂ aléatoire
    const sg = SIG[i];
    if (sg > 0) {
      const eps = sg * gauss();
      // base orthonormée (e1, e2) ⟂ d
      let hx = 1, hy = 0, hz = 0;
      if (Math.abs(ex) > 0.9) { hx = 0; hy = 1; }
      let e1x = ey * hz - ez * hy, e1y = ez * hx - ex * hz, e1z = ex * hy - ey * hx;
      const l1 = 1 / Math.sqrt(e1x * e1x + e1y * e1y + e1z * e1z);
      e1x *= l1; e1y *= l1; e1z *= l1;
      const e2x = ey * e1z - ez * e1y, e2y = ez * e1x - ex * e1z, e2z = ex * e1y - ey * e1x;
      const phi = 2 * Math.PI * Math.random(), cp = Math.cos(phi), sp = Math.sin(phi);
      const ux = cp * e1x + sp * e2x, uy = cp * e1y + sp * e2y, uz = cp * e1z + sp * e2z;
      const c = Math.cos(eps), s = Math.sin(eps);
      ex = ex * c + ux * s; ey = ey * c + uy * s; ez = ez * c + uz * s;
    }
    des[i3] = ex; des[i3 + 1] = ey; des[i3 + 2] = ez;
    zoneState[i] = zs;
  }

  // ---- (b) rotation vers d_i limitée à θτ, puis déplacement à vitesse constante s
  for (let i = 0; i < N; i++) {
    const i3 = 3 * i;
    let vx = dir[i3], vy = dir[i3 + 1], vz = dir[i3 + 2];
    const ex = des[i3], ey = des[i3 + 1], ez = des[i3 + 2];
    const maxTurn = TH[i] * TAU;
    let dot = vx * ex + vy * ey + vz * ez;
    if (dot > 1) dot = 1; else if (dot < -1) dot = -1;
    const ang = Math.acos(dot);

    if (ang <= maxTurn) { vx = ex; vy = ey; vz = ez; }          // v_i(t+τ) = d_i(t+τ)
    else {
      const sa = Math.sin(ang);
      if (sa < 1e-6) {
        // d_i exactement opposé à v_i : on tourne de θτ autour d'un axe ⟂ quelconque
        let hx = 1, hy = 0, hz = 0;
        if (Math.abs(vx) > 0.9) { hx = 0; hy = 1; }
        let ux = vy * hz - vz * hy, uy = vz * hx - vx * hz, uz = vx * hy - vy * hx;
        const l = 1 / Math.sqrt(ux * ux + uy * uy + uz * uz);
        const c = Math.cos(maxTurn), s = Math.sin(maxTurn) * l;
        vx = vx * c + ux * s; vy = vy * c + uy * s; vz = vz * c + uz * s;
      } else {
        // rotation de θτ dans le plan (v_i, d_i)
        const a = Math.sin(ang - maxTurn) / sa, b = Math.sin(maxTurn) / sa;
        vx = a * vx + b * ex; vy = a * vy + b * ey; vz = a * vz + b * ez;
      }
    }
    const l = 1 / Math.sqrt(vx * vx + vy * vy + vz * vz);
    vx *= l; vy *= l; vz *= l;
    dir[i3] = vx; dir[i3 + 1] = vy; dir[i3 + 2] = vz;

    const ds = S[i] * TAU;
    pos[i3] += vx * ds; pos[i3 + 1] += vy * ds; pos[i3 + 2] += vz * ds;
  }

  stepCount++;
  computeMetrics(true);
}

/* =====================================================================
   4.  MESURES GLOBALES — éq. (4), (5), (6)
   ===================================================================== */
function computeMetrics(withComponents) {
  const N = P.N;
  let cx = 0, cy = 0, cz = 0, sx = 0, sy = 0, sz = 0;
  for (let i = 0; i < N; i++) {
    const k = 3 * i;
    cx += pos[k]; cy += pos[k + 1]; cz += pos[k + 2];
    sx += dir[k]; sy += dir[k + 1]; sz += dir[k + 2];
  }
  cx /= N; cy /= N; cz /= N;                                    // c_group — éq. (6)
  pGroup = Math.sqrt(sx * sx + sy * sy + sz * sz) / N;          // p_group — éq. (4)

  let mx = 0, my = 0, mz = 0;
  for (let i = 0; i < N; i++) {
    const k = 3 * i;
    let rx = pos[k] - cx, ry = pos[k + 1] - cy, rz = pos[k + 2] - cz;
    const l = Math.sqrt(rx * rx + ry * ry + rz * rz);
    if (l < 1e-9) continue;
    rx /= l; ry /= l; rz /= l;                                  // r_ic normalisé → m ∈ [0, 1]
    const vx = dir[k], vy = dir[k + 1], vz = dir[k + 2];
    mx += ry * vz - rz * vy; my += rz * vx - rx * vz; mz += rx * vy - ry * vx;
  }
  mGroup = Math.sqrt(mx * mx + my * my + mz * mz) / N;          // m_group — éq. (5)

  if (withComponents) {
    // fragmentation : classes d'équivalence « i détecte j »
    for (let i = 0; i < N; i++) compSize[i] = 0;
    for (let i = 0; i < N; i++) compSize[find(i)]++;
    let best = 0, bestRoot = 0, count = 0;
    for (let i = 0; i < N; i++) if (compSize[i] > 0) { count++; if (compSize[i] > best) { best = compSize[i]; bestRoot = i; } }
    for (let i = 0; i < N; i++) inMain[i] = find(i) === bestRoot ? 1 : 0;
    nGroups = count; mainSize = best;

    histP[histHead] = pGroup; histM[histHead] = mGroup;
    histHead = (histHead + 1) % HN; if (histCount < HN) histCount++;
  }
}

function classify() {
  if (mainSize < 0.9 * P.N) return 'Groupe fragmenté';
  if (mGroup > 0.6 && pGroup < 0.5) return 'Tore (torus)';
  if (pGroup >= 0.97) return 'Groupe hautement parallèle';
  if (pGroup >= 0.6) return 'Groupe parallèle dynamique';
  if (pGroup < 0.35 && mGroup < 0.35) return 'Essaim (swarm)';
  return 'Transition…';
}

/* =====================================================================
   5.  EXPÉRIENCE D'HYSTÉRÉSIS (Fig. 4) : r_a = 14 fixe, r_o : 1 → 4 → 1
   ===================================================================== */
const sweep = { active: false, dir: 1, counter: 0, accP: 0, accM: 0, accN: 0, data: [] };

function setFig3Params() { P.rr = 1; P.alpha = 270; P.theta = 40; P.speed = 3; P.sigma = 0.05; }

function startSweep() {
  setFig3Params(); P.dro = 0; P.dra = 13;
  sweep.active = true; sweep.dir = 1; sweep.counter = 0;
  sweep.accP = sweep.accM = sweep.accN = 0; sweep.data = [];
  reset(); refreshGUI();
  document.getElementById('hyst').style.display = 'block';
  document.getElementById('hystCap').style.display = 'block';
  drawHyst();
}
function stopSweep() { sweep.active = false; }

function sweepTick() {
  if (!sweep.active) return;
  sweep.counter++;
  if (sweep.counter > P.sweepSteps / 2) { sweep.accP += pGroup; sweep.accM += mGroup; sweep.accN++; }
  if (sweep.counter >= P.sweepSteps) {
    const ro = P.rr + P.dro, n = Math.max(1, sweep.accN);
    sweep.data.push({ ro, dir: sweep.dir, p: sweep.accP / n, m: sweep.accM / n });
    sweep.counter = 0; sweep.accP = sweep.accM = sweep.accN = 0;
    let next = ro + 0.25 * sweep.dir;
    if (sweep.dir === 1 && next > 4.001) { sweep.dir = -1; next = ro - 0.25; }
    else if (sweep.dir === -1 && next < 0.999) { sweep.active = false; drawHyst(); return; }
    P.dro = next - P.rr; P.dra = 14 - next;
    applyParams(); refreshGUI(); drawHyst();
  }
}

/* =====================================================================
   6.  SCÈNE THREE.JS
   ===================================================================== */
const BG = 0x06131f;
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.domElement.classList.add('webgl');
document.body.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(BG);
scene.fog = new THREE.FogExp2(BG, 0.011);

const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
camera.position.set(18, 14, 42);
const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.enablePan = false;
controls.minDistance = 5; controls.maxDistance = 300;

scene.add(new THREE.HemisphereLight(0xcfeaff, 0x0b2233, 1.6));
const sun = new THREE.DirectionalLight(0xffffff, 1.8);
sun.position.set(1, 2, 1.5); scene.add(sun);

// --- géométrie d'un individu (profil de révolution, nez vers +Z), longueur 1
const profile = [[0, -0.5], [0.07, -0.47], [0.03, -0.36], [0.09, -0.12], [0.13, 0.12], [0.11, 0.3], [0.05, 0.44], [0, 0.5]]
  .map(p => new THREE.Vector2(p[0], p[1]));
const fishGeo = new THREE.LatheGeometry(profile, 10);
fishGeo.rotateX(Math.PI / 2);
const fishMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.45, metalness: 0.1, side: THREE.DoubleSide });
const fish = new THREE.InstancedMesh(fishGeo, fishMat, MAX_N);
fish.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
fish.frustumCulled = false;
{ const w = new THREE.Color(1, 1, 1); for (let i = 0; i < MAX_N; i++) fish.setColorAt(i, w); }
scene.add(fish);

// --- particules fixes (repère visuel du déplacement dans l'espace non borné)
const PL_N = 1400, PL_L = 160;
const plBase = new Float32Array(3 * PL_N), plPos = new Float32Array(3 * PL_N);
for (let i = 0; i < 3 * PL_N; i++) plBase[i] = Math.random() * PL_L;
const plGeo = new THREE.BufferGeometry();
plGeo.setAttribute('position', new THREE.BufferAttribute(plPos, 3));
const plankton = new THREE.Points(plGeo, new THREE.PointsMaterial({ color: 0x86bfe0, size: 0.28, transparent: true, opacity: 0.65, sizeAttenuation: true }));
plankton.frustumCulled = false;
scene.add(plankton);

// --- visualisation des zones de l'individu n°0 (Fig. 1)
const sphGeo = new THREE.SphereGeometry(1, 48, 24);
function mkZone(color, opacity, order) {
  const m = new THREE.Mesh(sphGeo, new THREE.MeshBasicMaterial({ color, transparent: true, opacity, depthWrite: false }));
  m.visible = false; m.renderOrder = order; scene.add(m); return m;
}
const zoaMesh = mkZone(0xffd24d, 0.07, 1);
const zooMesh = mkZone(0x4dd2ff, 0.15, 2);
const zorMesh = mkZone(0xff4d4d, 0.35, 3);
const coneGeo = new THREE.ConeGeometry(1, 1, 40, 1, true);
coneGeo.translate(0, -0.5, 0);                         // sommet à l'origine, base en −Y
const blindMesh = new THREE.Mesh(coneGeo, new THREE.MeshBasicMaterial({ color: 0xb08cff, transparent: true, opacity: 0.2, depthWrite: false, side: THREE.DoubleSide }));
blindMesh.visible = false; blindMesh.renderOrder = 4; scene.add(blindMesh);

// --- couleurs
const ZONE_COLORS = [0x8a97a3, 0xff4d4d, 0x4dd2ff, 0xffd24d, 0x7dff8a].map(c => new THREE.Color(c));
const C_LOW = new THREE.Color(0x2f6bff), C_HIGH = new THREE.Color(0xff9a2e), C_WHITE = new THREE.Color(0xffffff), C_UNI = new THREE.Color(0x9fd8ff);

const _m = new THREE.Matrix4(), _q = new THREE.Quaternion(), _p = new THREE.Vector3(), _s = new THREE.Vector3();
const _d = new THREE.Vector3(), _zAxis = new THREE.Vector3(0, 0, 1), _yAxis = new THREE.Vector3(0, 1, 0), _c = new THREE.Color();
const _target = new THREE.Vector3(), _delta = new THREE.Vector3();

function updateScene(a, dt) {
  const N = P.N, b = 1 - a;
  let cx = 0, cy = 0, cz = 0, cnt = 0;
  _s.set(P.size, P.size, P.size);

  for (let i = 0; i < N; i++) {
    const k = 3 * i;
    _p.set(b * prevPos[k] + a * pos[k], b * prevPos[k + 1] + a * pos[k + 1], b * prevPos[k + 2] + a * pos[k + 2]);
    _d.set(b * prevDir[k] + a * dir[k], b * prevDir[k + 1] + a * dir[k + 1], b * prevDir[k + 2] + a * dir[k + 2]);
    if (_d.lengthSq() < 1e-12) _d.set(dir[k], dir[k + 1], dir[k + 2]);
    _d.normalize();
    _q.setFromUnitVectors(_zAxis, _d);
    _m.compose(_p, _q, _s);
    fish.setMatrixAt(i, _m);

    switch (P.colorMode) {
      case 'zone': _c.copy(ZONE_COLORS[zoneState[i]]); break;
      case 'variation':
        if (P.varParam === 'none') _c.copy(C_UNI);
        else { const t = Math.max(-1, Math.min(1, Z[i] / 2)); _c.copy(C_WHITE).lerp(t < 0 ? C_LOW : C_HIGH, Math.abs(t)); }
        break;
      case 'uniform': _c.copy(C_UNI); break;
      default: _c.setHSL(Math.atan2(_d.z, _d.x) / (2 * Math.PI) + 0.5, 0.75, 0.55 + 0.2 * _d.y);
    }
    if (P.showZones && i === 0) _c.copy(C_WHITE);
    fish.setColorAt(i, _c);

    if (inMain[i]) { cx += _p.x; cy += _p.y; cz += _p.z; cnt++; }

    if (i === 0) {
      const show = P.showZones;
      zorMesh.visible = zooMesh.visible = zoaMesh.visible = show;
      blindMesh.visible = show && P.alpha < 360;
      if (show) {
        zorMesh.position.copy(_p); zorMesh.scale.setScalar(RR[0]);
        zooMesh.position.copy(_p); zooMesh.scale.setScalar(RO[0]);
        zoaMesh.position.copy(_p); zoaMesh.scale.setScalar(RA[0]);
        const beta = 0.5 * (360 - P.alpha) * DEG;       // demi-angle du cône aveugle
        blindMesh.position.copy(_p);
        blindMesh.quaternion.setFromUnitVectors(_yAxis, _d);
        blindMesh.scale.set(RA[0] * Math.sin(beta), Math.max(1e-3, RA[0] * Math.cos(beta)), RA[0] * Math.sin(beta));
      }
    }
  }
  fish.count = N;
  fish.instanceMatrix.needsUpdate = true;
  fish.instanceColor.needsUpdate = true;

  // caméra : suit le centroïde du plus grand groupe
  if (P.follow && cnt > 0) {
    _target.set(cx / cnt, cy / cnt, cz / cnt);
    const kf = snapCam ? 1 : 1 - Math.exp(-dt * 4 * Math.max(1, P.timeScale));
    _delta.subVectors(_target, controls.target).multiplyScalar(kf);
    controls.target.add(_delta); camera.position.add(_delta);
    snapCam = false;
  }
  controls.update();

  // particules : répétition périodique autour de la cible
  const t = controls.target;
  for (let i = 0; i < PL_N; i++) {
    const k = 3 * i;
    plPos[k]     = plBase[k]     + PL_L * Math.round((t.x - plBase[k])     / PL_L);
    plPos[k + 1] = plBase[k + 1] + PL_L * Math.round((t.y - plBase[k + 1]) / PL_L);
    plPos[k + 2] = plBase[k + 2] + PL_L * Math.round((t.z - plBase[k + 2]) / PL_L);
  }
  plGeo.attributes.position.needsUpdate = true;
}

/* =====================================================================
   7.  HUD : statistiques et graphiques
   ===================================================================== */
const statsEl = document.getElementById('stats'), legendEl = document.getElementById('legend');
const plotCtx = document.getElementById('plot').getContext('2d');
const hystCtx = document.getElementById('hyst').getContext('2d');
plotCtx.scale(2, 2); hystCtx.scale(2, 2);
const CP = '#5fd3ff', CM = '#ffa94d';

function updateHUD() {
  const ro = P.rr + P.dro, ra = ro + P.dra;
  let h = '';
  h += `<div class="row"><span>temps simulé</span><b>${(stepCount * TAU).toFixed(1)} s &nbsp;(${stepCount} pas)</b></div>`;
  h += `<div class="row"><span>r<sub>r</sub> / r<sub>o</sub> / r<sub>a</sub></span><b>${P.rr.toFixed(2)} / ${ro.toFixed(2)} / ${ra.toFixed(2)}</b></div>`;
  h += `<div class="row"><span class="cp">p<sub>group</sub></span><b>${pGroup.toFixed(3)}</b></div>`;
  h += `<div class="row"><span class="cm">m<sub>group</sub></span><b>${mGroup.toFixed(3)}</b></div>`;
  h += `<div class="row"><span>groupes (plus grand)</span><b>${nGroups} (${mainSize}/${P.N})</b></div>`;
  h += `<div class="row"><span>état estimé</span><b>${classify()}</b></div>`;
  if (sweep.active) h += `<div class="row"><span>balayage r<sub>o</sub> ${sweep.dir > 0 ? '↑' : '↓'}</span><b>${sweep.counter}/${P.sweepSteps} pas</b></div>`;
  statsEl.innerHTML = h;

  let l = '';
  if (P.colorMode === 'zone')
    l = '<span class="dot" style="background:#ff4d4d"></span>répulsion<span class="dot" style="background:#4dd2ff"></span>orientation<span class="dot" style="background:#ffd24d"></span>attraction<br><span class="dot" style="background:#7dff8a"></span>orient. + attr.<span class="dot" style="background:#8a97a3"></span>aucun voisin';
  else if (P.colorMode === 'variation' && P.varParam !== 'none')
    l = '<span class="dot" style="background:#2f6bff"></span>valeur faible<span class="dot" style="background:#fff"></span>moyenne<span class="dot" style="background:#ff9a2e"></span>valeur élevée';
  else if (P.colorMode === 'direction') l = 'Couleur = direction de nage';
  if (legendEl.innerHTML !== l) legendEl.innerHTML = l;
}

function drawPlot() {
  const w = 300, h = 110, ctx = plotCtx;
  ctx.clearRect(0, 0, w, h);
  ctx.strokeStyle = 'rgba(255,255,255,0.12)'; ctx.lineWidth = 1; ctx.setLineDash([]);
  ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px system-ui';
  for (const v of [0, 0.5, 1]) {
    const y = h - 6 - v * (h - 12);
    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke();
    ctx.fillText(v.toString(), 2, y - 2);
  }
  const n = histCount;
  const series = (arr, col) => {
    ctx.strokeStyle = col; ctx.lineWidth = 1.4; ctx.beginPath();
    for (let k = 0; k < n; k++) {
      const idx = (histHead - n + k + HN) % HN;
      const x = (k / (HN - 1)) * w, y = h - 6 - arr[idx] * (h - 12);
      if (k === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
  };
  series(histM, CM); series(histP, CP);
}

function drawHyst() {
  const w = 300, h = 110, ctx = hystCtx;
  const X = ro => 22 + ((ro - 1) / 3) * (w - 34), Y = v => h - 18 - v * (h - 28);
  ctx.clearRect(0, 0, w, h);
  ctx.setLineDash([]); ctx.strokeStyle = 'rgba(255,255,255,0.12)'; ctx.lineWidth = 1;
  ctx.fillStyle = 'rgba(255,255,255,0.45)'; ctx.font = '9px system-ui';
  for (const v of [0, 0.5, 1]) { ctx.beginPath(); ctx.moveTo(X(1), Y(v)); ctx.lineTo(X(4), Y(v)); ctx.stroke(); ctx.fillText(v.toString(), 4, Y(v) + 3); }
  for (const r of [1, 2, 3, 4]) ctx.fillText(r.toString(), X(r) - 2, h - 5);
  ctx.fillText('r_o', w - 16, h - 5);
  for (const key of ['p', 'm']) for (const d of [1, -1]) {
    const pts = sweep.data.filter(e => e.dir === d);
    if (!pts.length) continue;
    const col = key === 'p' ? CP : CM;
    ctx.strokeStyle = col; ctx.lineWidth = 1.4; ctx.setLineDash(d === 1 ? [] : [4, 3]);
    ctx.beginPath();
    pts.forEach((e, k) => { if (k === 0) ctx.moveTo(X(e.ro), Y(e[key])); else ctx.lineTo(X(e.ro), Y(e[key])); });
    ctx.stroke(); ctx.setLineDash([]);
    for (const e of pts) {
      ctx.beginPath(); ctx.arc(X(e.ro), Y(e[key]), 2.6, 0, 2 * Math.PI);
      if (d === 1) { ctx.fillStyle = col; ctx.fill(); } else { ctx.fillStyle = '#06131f'; ctx.fill(); ctx.stroke(); }
    }
  }
}

/* =====================================================================
   8.  INTERFACE (lil-gui)
   ===================================================================== */
const gui = new GUI({ title: 'Modèle de Couzin et al. (2002)', width: 310 });
function refreshGUI() { gui.controllersRecursive().forEach(c => c.updateDisplay()); }

function preset(dro, dra) {
  stopSweep(); setFig3Params();
  P.dro = dro; P.dra = dra;
  applyParams();
  if (P.resetOnPreset) reset();
  refreshGUI();
}
const actions = {
  swarm:    () => preset(0, 13),       // r_o = 1,   r_a = 14
  torus:    () => preset(1, 12),       // r_o = 2,   r_a = 14
  dynamic:  () => preset(3.5, 9.5),    // r_o = 4.5, r_a = 14
  parallel: () => preset(11, 2),       // r_o = 12,  r_a = 14
  reset:    () => { stopSweep(); reset(); },
  startSweep, stopSweep,
};

const fPre = gui.addFolder('Préréglages (paramètres de la Fig. 3)');
fPre.add(actions, 'swarm').name('A · Essaim (swarm)');
fPre.add(actions, 'torus').name('B · Tore (torus)');
fPre.add(actions, 'dynamic').name('C · Groupe parallèle dynamique');
fPre.add(actions, 'parallel').name('D · Groupe hautement parallèle');
fPre.add(P, 'resetOnPreset').name('réinitialiser à chaque préréglage');

const fM = gui.addFolder('Paramètres du modèle (Table 1)');
fM.add(P, 'N', 10, MAX_N, 1).name('N — individus').onFinishChange(() => { stopSweep(); reset(); });
fM.add(P, 'rr', 0.5, 3, 0.05).name('r_r — répulsion').onChange(applyParams);
fM.add(P, 'dro', 0, 15, 0.05).name('Δr_o — orientation').onChange(applyParams);
fM.add(P, 'dra', 0, 15, 0.05).name('Δr_a — attraction').onChange(applyParams);
fM.add(P, 'alpha', 180, 360, 1).name('α — champ de perception (°)');
fM.add(P, 'theta', 10, 100, 1).name('θ — taux de rotation (°/s)').onChange(applyParams);
fM.add(P, 'speed', 1, 5, 0.1).name('s — vitesse (unités/s)').onChange(applyParams);
fM.add(P, 'sigma', 0, 0.2, 0.005).name('σ — erreur (rad)').onChange(applyParams);

const fS = gui.addFolder('Simulation');
fS.add(P, 'timeScale', 0.25, 50, 0.25).name('accélération ×');
fS.add(P, 'paused').name('pause');
fS.add(actions, 'reset').name('↺ Réinitialiser (aléatoire)');

const VAR_DEFAULT_SD = { none: 0, s: 0.2, theta: 8, rr: 0.3, ro: 2.5, ra: 1, sigma: 0.02 };
const fV = gui.addFolder('Variation individuelle (self-sorting, Fig. 5)');
fV.add(P, 'varParam', { 'aucune': 'none', 'vitesse s': 's', 'taux de rotation θ': 'theta', 'r_r': 'rr', 'r_o': 'ro', 'r_a': 'ra', 'erreur σ': 'sigma' })
  .name('paramètre varié')
  .onChange(v => { P.varSd = VAR_DEFAULT_SD[v]; if (v !== 'none') P.colorMode = 'variation'; applyParams(); refreshGUI(); });
fV.add(P, 'varSd', 0, 8, 0.01).name('écart-type').onChange(applyParams);
fV.close();

const fH = gui.addFolder('Hystérésis / mémoire collective (Fig. 4)');
fH.add(P, 'sweepSteps', 100, 5000, 100).name('pas par valeur de r_o');
fH.add(actions, 'startSweep').name('▶ Balayage r_o : 1 → 4 → 1');
fH.add(actions, 'stopSweep').name('■ Arrêter le balayage');
fH.close();

const fD = gui.addFolder('Affichage');
fD.add(P, 'colorMode', { 'direction': 'direction', 'zone active': 'zone', 'variation individuelle': 'variation', 'uniforme': 'uniform' }).name('couleur');
fD.add(P, 'size', 0.5, 3, 0.1).name('taille des individus');
fD.add(P, 'showZones').name('zones de l\'individu n°0 (Fig. 1)');
fD.add(P, 'follow').name('caméra suit le groupe');

window.addEventListener('keydown', e => {
  if (e.code === 'Space') { P.paused = !P.paused; refreshGUI(); e.preventDefault(); }
  else if (e.key === 'r' || e.key === 'R') actions.reset();
});
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

/* =====================================================================
   9.  BOUCLE PRINCIPALE
   ===================================================================== */
reset();
let acc = 0, last = performance.now(), hudTimer = 0;

function animate(now) {
  requestAnimationFrame(animate);
  const dt = Math.min(0.1, (now - last) / 1000); last = now;

  if (!P.paused) {
    acc += dt * P.timeScale;
    const t0 = performance.now();
    while (acc >= TAU) {
      step(); sweepTick();
      acc -= TAU;
      if (performance.now() - t0 > 14) { acc %= TAU; break; }   // budget de calcul par image
    }
  }
  updateScene(acc / TAU, dt);       // interpolation entre t et t+τ pour un rendu fluide
  renderer.render(scene, camera);

  hudTimer += dt;
  if (hudTimer > 0.1) { hudTimer = 0; updateHUD(); drawPlot(); }
}
requestAnimationFrame(animate);
</script>
