  <canvas id="three-canvas"></canvas>

  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

    // ========================================================================
    // 1. CONSTANTES
    // ========================================================================
    const TAU = 0.1;                    // pas de temps (Table 1)
    const TWO_PI = Math.PI * 2;

    // Extensions hors article (inspirées de la Discussion)
    const R_OBS = 6.0;                  // rayon de détection des obstacles
    const R_GROUND = 7.0;               // marge de détection du relief
    const R_FEAR = 20.0;                // distance de détection du faucon
    const URGENT_TURN = 2.5;            // facteur de rotation en urgence (fuite / évitement)
    const PRED_TURN = 130;              // taux de rotation du faucon (°/s)
    const PRED_CAPTURE_R = 1.4;         // distance de capture
    const PRED_COOLDOWN = 30;           // pas (3 s) après une capture
    const OBS_MAX = 40;                 // nombre maximal d'obstacles ajoutés

    const WORLD_UP = new THREE.Vector3(0, 1, 0);
    const ALT_UP = new THREE.Vector3(1, 0, 0);
    const ZERO_VEC = new THREE.Vector3(0, 0, 0);

    const params = {
      N: 100,
      rr: 1.0,
      dro: 5.0,
      dra: 8.0,
      alpha: 270,
      theta: 40,
      s: 3.0,
      sigma: 0.05,
      predSpeed: 4.6,
      sortParam: 'none',
      sortSD: 0.15,
      simSpeed: 2.0,
      paused: false,
      followGroup: true,
      showTrails: true,
      showGroupPlane: false,
      showBirdZones: false
    };

    const hysteresis = {
      active: false,
      direction: 1,
      roCurrent: 1.0,
      stepsAtValue: 0,
      stepsPerIncrement: 180,
      upPoints: [],
      downPoints: []
    };

    // ========================================================================
    // 2. ÉTAT
    // ========================================================================
    const MAX_N = 150;
    const posX = new Float64Array(MAX_N), posY = new Float64Array(MAX_N), posZ = new Float64Array(MAX_N);
    const prevPosX = new Float64Array(MAX_N), prevPosY = new Float64Array(MAX_N), prevPosZ = new Float64Array(MAX_N);
    const velX = new Float64Array(MAX_N), velY = new Float64Array(MAX_N), velZ = new Float64Array(MAX_N);
    const prevVelX = new Float64Array(MAX_N), prevVelY = new Float64Array(MAX_N), prevVelZ = new Float64Array(MAX_N);
    const nextVelX = new Float64Array(MAX_N), nextVelY = new Float64Array(MAX_N), nextVelZ = new Float64Array(MAX_N);
    const alive = new Uint8Array(MAX_N);

    const indivZScore = new Float64Array(MAX_N);
    const indivPhase = new Float32Array(MAX_N);
    const indivBank = new Float32Array(MAX_N);

    let stepCount = 0;
    let pGroup = 0, mGroup = 0;
    let nAlive = 0, numClusters = 1, captures = 0;
    let lastZoneIdx = -1;

    const cGroup = new THREE.Vector3();
    const prevCGroup = new THREE.Vector3();
    const dGroup = new THREE.Vector3(0, 0, 1);
    const cameraFollowTarget = new THREE.Vector3();

    const timeHistory = [];
    const MAX_HISTORY = 180;

    // Faucon
    const predator = { active: false, x: 0, y: 0, z: 0, px: 0, py: 0, pz: 0, vx: 1, vy: 0, vz: 0, cooldown: 0, phase: 0 };

    // Environnement
    let currentBiome = 'forest';
    let seedOff = 0;
    let envObstacles = [];     // décor (troncs, rochers)
    let userObstacles = [];    // obstacles ajoutés par l'utilisateur
    let obsFlat = new Float64Array(0); // [ax, ay, az, bx, by, bz, R] par obstacle
    let obsCount = 0;

    const BIOME_SETTINGS = {
      none:     { sky: [0x0c2448, 0x1e4d7b, 0x7ca5c8, 0x182638], fog: null, spawnAlt: 20 },
      forest:   { sky: [0x2a4f7a, 0x4f7fa8, 0xb9cbd6, 0x2b3a2a], fog: [0xaebfb5, 0.010], spawnAlt: 9 },
      lake:     { sky: [0x2c6fa8, 0x5b9ccc, 0xdbe9f2, 0x3b6e8a], fog: [0xc9dde9, 0.0065], spawnAlt: 9 },
      mountain: { sky: [0x1b3658, 0x406a95, 0xa9bcd0, 0x3c4a5a], fog: [0xb8c6d4, 0.006], spawnAlt: 14 },
      plain:    { sky: [0x3c78b5, 0x7cb0d8, 0xf4e4b8, 0x8a7a4c], fog: [0xe9d9ae, 0.0045], spawnAlt: 10 }
    };

    // ========================================================================
    // 3. BRUIT, MATHÉMATIQUES UTILITAIRES
    // ========================================================================
    function randomStandardNormal() {
      let u1 = 0, u2 = 0;
      while (u1 === 0) u1 = Math.random();
      while (u2 === 0) u2 = Math.random();
      return Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(TWO_PI * u2);
    }

    // Vecteur unitaire tourné par un angle err dans un plan tangent aléatoire (gaussienne sphérique)
    const _pert = new THREE.Vector3();
    function perturbDirection(dx, dy, dz, err) {
      let ux, uy, uz;
      if (Math.abs(dx) < 0.9) { ux = 0; uy = -dz; uz = dy; }
      else { ux = dz; uy = 0; uz = -dx; }
      const ul = Math.hypot(ux, uy, uz);
      ux /= ul; uy /= ul; uz /= ul;
      const wx = dy * uz - dz * uy, wy = dz * ux - dx * uz, wz = dx * uy - dy * ux;
      const phi = Math.random() * TWO_PI;
      const cp = Math.cos(phi), sp = Math.sin(phi);
      const tx = cp * ux + sp * wx, ty = cp * uy + sp * wy, tz = cp * uz + sp * wz;
      const ce = Math.cos(err), se = Math.sin(err);
      _pert.set(ce * dx + se * tx, ce * dy + se * ty, ce * dz + se * tz).normalize();
      return _pert;
    }

    // Rotation limitée de v vers d (angle maximal maxRad) — résultat dans _turn
    const _turn = new THREE.Vector3();
    function turnLimited(vx, vy, vz, dx, dy, dz, maxRad) {
      const dot = Math.max(-1, Math.min(1, vx * dx + vy * dy + vz * dz));
      const ang = Math.acos(dot);
      if (ang <= maxRad || ang < 1e-7) {
        _turn.set(dx, dy, dz);
        return _turn.normalize();
      }
      let px = dx - dot * vx, py = dy - dot * vy, pz = dz - dot * vz;
      let pl = Math.hypot(px, py, pz);
      if (pl < 1e-7) {
        if (Math.abs(vx) < 0.9) { px = 0; py = -vz; pz = vy; }
        else { px = vz; py = 0; pz = -vx; }
        pl = Math.hypot(px, py, pz);
      }
      px /= pl; py /= pl; pz /= pl;
      const c = Math.cos(maxRad), s = Math.sin(maxRad);
      _turn.set(c * vx + s * px, c * vy + s * py, c * vz + s * pz);
      return _turn.normalize();
    }

    // Paramètres individuels (avec variation gaussienne pour le tri spatial)
    function getIndividualParams(i) {
      let rr_i = params.rr;
      let ro_i = params.rr + params.dro;
      let ra_i = ro_i + params.dra;
      let theta_i = params.theta;
      let s_i = params.s;
      let sigma_i = params.sigma;
      const z = indivZScore[i];
      if (params.sortParam === 's') {
        s_i = Math.max(0.4, params.s + z * params.sortSD);
      } else if (params.sortParam === 'rr') {
        rr_i = Math.max(0.15, params.rr + z * params.sortSD);
        ro_i = Math.max(rr_i, params.rr + params.dro);
        ra_i = Math.max(ro_i, ro_i + params.dra);
      } else if (params.sortParam === 'theta') {
        theta_i = Math.max(2.0, params.theta + z * params.sortSD);
      } else if (params.sortParam === 'ro') {
        ro_i = Math.max(rr_i, (params.rr + params.dro) + z * params.sortSD);
        ra_i = Math.max(ro_i, (params.rr + params.dro + params.dra));
      } else if (params.sortParam === 'sigma') {
        sigma_i = Math.max(0.0, params.sigma + z * params.sortSD);
      }
      return { rr_i, ro_i, ra_i, theta_i, s_i, sigma_i };
    }

    // ========================================================================
    // 4. RELIEF (bruit fractal) — sert au sol, à la végétation et à l'eau
    // ========================================================================
    function hash2(x, z) {
      const s = Math.sin(x * 127.1 + z * 311.7) * 43758.5453123;
      return s - Math.floor(s);
    }
    function vnoise(x, z) {
      const ix = Math.floor(x), iz = Math.floor(z);
      const fx = x - ix, fz = z - iz;
      const ux = fx * fx * (3 - 2 * fx), uz = fz * fz * (3 - 2 * fz);
      const a = hash2(ix, iz), b = hash2(ix + 1, iz), c = hash2(ix, iz + 1), d = hash2(ix + 1, iz + 1);
      return a + (b - a) * ux + (c - a) * uz + (a - b - c + d) * ux * uz;
    }
    function fbm(x, z) {
      let amp = 0.5, f = 1, sum = 0, norm = 0;
      for (let o = 0; o < 4; o++) {
        sum += amp * vnoise(x * f, z * f);
        norm += amp;
        amp *= 0.5;
        f *= 2.0;
      }
      return sum / norm;
    }

    // Altitude brute du terrain selon le biome courant
    function groundRaw(x, z) {
      if (currentBiome === 'none') return -1000;
      const X = x + seedOff, Z = z + seedOff;
      switch (currentBiome) {
        case 'forest':   return -1 + 16 * Math.pow(fbm(X * 0.011, Z * 0.011), 1.5) + 2.5 * fbm(X * 0.06, Z * 0.06);
        case 'lake':     return 3 + 9 * fbm(X * 0.014, Z * 0.014) + 2 * fbm(X * 0.07, Z * 0.07)
                              - 15 * Math.exp(-(x * x + z * z) / (2 * 30 * 30));
        case 'mountain': return 90 * Math.pow(fbm(X * 0.010, Z * 0.010), 2.0) + 6 * fbm(X * 0.07, Z * 0.07);
        case 'plain':    return 2 + 4 * fbm(X * 0.007, Z * 0.007) + 1.2 * fbm(X * 0.05, Z * 0.05);
      }
      return 0;
    }
    // Surface effective (l'eau du lac fixe la surface à y = 0)
    function groundH(x, z) {
      const h = groundRaw(x, z);
      return currentBiome === 'lake' ? Math.max(h, 0) : h;
    }
    function floorAt(x, z) {
      return currentBiome === 'none' ? 0 : groundH(x, z);
    }
    const _gn = new THREE.Vector3();
    function groundNormal(x, z) {
      const e = 0.8;
      const hx = (groundH(x + e, z) - groundH(x - e, z)) / (2 * e);
      const hz = (groundH(x, z + e) - groundH(x, z - e)) / (2 * e);
      return _gn.set(-hx, 1, -hz).normalize();
    }

    // ========================================================================
    // 5. OBSTACLES (capsules verticales : sphère si A = B, cylindre sinon)
    // ========================================================================
    const _q = new THREE.Vector3();
    // Distance du point p au segment [A, B] ; le point le plus proche est dans _q
    function capsuleDist(px, py, pz, ax, ay, az, bx, by, bz) {
      const abx = bx - ax, aby = by - ay, abz = bz - az;
      const ab2 = abx * abx + aby * aby + abz * abz;
      let t = 0;
      if (ab2 > 1e-12) {
        t = ((px - ax) * abx + (py - ay) * aby + (pz - az) * abz) / ab2;
        if (t < 0) t = 0; else if (t > 1) t = 1;
      }
      _q.set(ax + abx * t, ay + aby * t, az + abz * t);
      return Math.hypot(px - _q.x, py - _q.y, pz - _q.z);
    }

    function rebuildObstacleFlat() {
      const all = envObstacles.concat(userObstacles);
      obsCount = all.length;
      obsFlat = new Float64Array(obsCount * 7);
      for (let k = 0; k < obsCount; k++) {
        const o = all[k], b = k * 7;
        obsFlat[b] = o.ax; obsFlat[b + 1] = o.ay; obsFlat[b + 2] = o.az;
        obsFlat[b + 3] = o.bx; obsFlat[b + 4] = o.by; obsFlat[b + 5] = o.bz;
        obsFlat[b + 6] = o.R;
      }
    }

    // Contrainte dure : hors des obstacles et au-dessus du sol
    const _res = new THREE.Vector3();
    function resolveEnvironment(px, py, pz) {
      _res.set(px, py, pz);
      for (let k = 0; k < obsCount; k++) {
        const b = k * 7;
        const R = obsFlat[b + 6];
        const hdx = _res.x - obsFlat[b], hdz = _res.z - obsFlat[b + 2];
        if (hdx * hdx + hdz * hdz > (R + 0.05) * (R + 0.05)) continue; // axes verticaux
        const d = capsuleDist(_res.x, _res.y, _res.z,
          obsFlat[b], obsFlat[b + 1], obsFlat[b + 2], obsFlat[b + 3], obsFlat[b + 4], obsFlat[b + 5]);
        if (d < R + 0.05) {
          let nx = 0, ny = 1, nz = 0;
          if (d > 1e-6) { nx = (_res.x - _q.x) / d; ny = (_res.y - _q.y) / d; nz = (_res.z - _q.z) / d; }
          const push = R + 0.05;
          _res.set(_q.x + nx * push, _q.y + ny * push, _q.z + nz * push);
        }
      }
      const gh = floorAt(_res.x, _res.z) + 0.6;
      if (_res.y < gh) _res.y = gh;
      return _res;
    }

    // ========================================================================
    // 6. INITIALISATION DE LA NUÉE (Page 4)
    // ========================================================================
    function spawnBaseY() {
      return currentBiome === 'none' ? BIOME_SETTINGS.none.spawnAlt : floorAt(0, 0) + BIOME_SETTINGS[currentBiome].spawnAlt;
    }

    function initFlock(redrawDeviates = true) {
      const N = params.N;
      const raBase = Math.max(1.5, params.rr + params.dro + params.dra);
      const initRadius = Math.min(Math.max(2.5, 0.9 * Math.cbrt(N)), raBase * 0.55);
      const baseY = spawnBaseY();

      for (let i = 0; i < MAX_N; i++) {
        if (redrawDeviates) indivZScore[i] = randomStandardNormal();
        indivPhase[i] = Math.random() * TWO_PI;
        indivBank[i] = 0;
        alive[i] = i < N ? 1 : 0;

        const u = Math.random();
        const r = initRadius * Math.cbrt(u);
        const cosPhi = 2 * Math.random() - 1;
        const sinPhi = Math.sqrt(1 - cosPhi * cosPhi);
        const az = Math.random() * TWO_PI;
        posX[i] = r * sinPhi * Math.cos(az);
        posY[i] = baseY + r * cosPhi;
        posZ[i] = r * sinPhi * Math.sin(az);

        const vc = 2 * Math.random() - 1;
        const vs = Math.sqrt(1 - vc * vc);
        const vaz = Math.random() * TWO_PI;
        velX[i] = vs * Math.cos(vaz);
        velY[i] = vs * Math.sin(vaz);
        velZ[i] = vc;
      }

      // Chaque oiseau doit détecter au moins un voisin
      const cosHalfAlpha = Math.cos((params.alpha * Math.PI) / 360.0);
      for (let i = 0; i < N; i++) {
        const pr = getIndividualParams(i);
        let detects = false;
        for (let j = 0; j < N; j++) {
          if (i === j) continue;
          const dx = posX[j] - posX[i], dy = posY[j] - posY[i], dz = posZ[j] - posZ[i];
          const d = Math.hypot(dx, dy, dz);
          if (d < pr.rr_i) { detects = true; break; }
          if (d <= pr.ra_i && d > 1e-8) {
            const dot = (velX[i] * dx + velY[i] * dy + velZ[i] * dz) / d;
            if (dot >= cosHalfAlpha) { detects = true; break; }
          }
        }
        if (!detects && N > 1) {
          const ref = (i + 1) % N;
          const dist = Math.min(pr.rr_i * 1.2, pr.ra_i * 0.5);
          posX[i] = posX[ref] - velX[i] * dist;
          posY[i] = posY[ref] - velY[i] * dist;
          posZ[i] = posZ[ref] - velZ[i] * dist;
        }
      }

      // Aucun oiseau ne doit être dans un obstacle ou sous le sol
      for (let i = 0; i < N; i++) {
        const r = resolveEnvironment(posX[i], posY[i], posZ[i]);
        posX[i] = r.x; posY[i] = r.y; posZ[i] = r.z;
      }
      for (let i = 0; i < MAX_N; i++) {
        prevPosX[i] = posX[i]; prevPosY[i] = posY[i]; prevPosZ[i] = posZ[i];
        prevVelX[i] = velX[i]; prevVelY[i] = velY[i]; prevVelZ[i] = velZ[i];
      }

      captures = 0;
      stepCount = 0;
      timeHistory.length = 0;
      computeGlobalMetrics();
      prevCGroup.copy(cGroup);
      cameraFollowTarget.copy(cGroup);
      resetTrails();
      updateBirdColors();
      if (predator.active) spawnPredator();
    }

    // ========================================================================
    // 7. UN PAS DE TEMPS (t -> t + τ)
    // ========================================================================
    function stepSimulation() {
      const N = params.N;
      const cosHalfAlpha = Math.cos((params.alpha * Math.PI) / 360.0);

      for (let i = 0; i < N; i++) {
        prevPosX[i] = posX[i]; prevPosY[i] = posY[i]; prevPosZ[i] = posZ[i];
        prevVelX[i] = velX[i]; prevVelY[i] = velY[i]; prevVelZ[i] = velZ[i];
      }
      prevCGroup.copy(cGroup);

      // 1) Direction désirée et rotation de chaque oiseau
      for (let i = 0; i < N; i++) {
        if (!alive[i]) {
          nextVelX[i] = velX[i]; nextVelY[i] = velY[i]; nextVelZ[i] = velZ[i];
          continue;
        }
        const pr = getIndividualParams(i);
        const xi = posX[i], yi = posY[i], zi = posZ[i];
        const vxi = velX[i], vyi = velY[i], vzi = velZ[i];
        let diX = 0, diY = 0, diZ = 0;
        let urgent = false;

        // ---- Niveau 0 : obstacles et relief ----
        let oX = 0, oY = 0, oZ = 0, nO = 0;
        for (let k = 0; k < obsCount; k++) {
          const b = k * 7;
          const R = obsFlat[b + 6];
          const hdx = xi - obsFlat[b], hdz = zi - obsFlat[b + 2];
          const lim = R_OBS + R;
          if (hdx * hdx + hdz * hdz > lim * lim) continue;
          const dist = capsuleDist(xi, yi, zi,
            obsFlat[b], obsFlat[b + 1], obsFlat[b + 2], obsFlat[b + 3], obsFlat[b + 4], obsFlat[b + 5]);
          const gap = dist - R;
          if (gap >= R_OBS) continue;
          // Normale sortante n = (c_i - q) / |c_i - q|
          let nX = 0, nY = 1, nZ = 0;
          if (dist > 1e-6) { nX = (xi - _q.x) / dist; nY = (yi - _q.y) / dist; nZ = (zi - _q.z) / dist; }
          // Visible si dans le cône de perception, ou déjà à moins de rr
          const cosTo = -(vxi * nX + vyi * nY + vzi * nZ);
          if (gap >= pr.rr_i && cosTo < cosHalfAlpha) continue;
          const w = Math.min(1, Math.max(0, (R_OBS - gap) / R_OBS));
          oX += nX * w; oY += nY * w; oZ += nZ * w; nO++;
        }
        // Relief : marge au-dessus du sol
        const gapG = yi - groundH(xi, zi);
        if (gapG < R_GROUND) {
          const n = groundNormal(xi, zi);
          const w = Math.min(1, (R_GROUND - gapG) / R_GROUND);
          oX += n.x * w; oY += n.y * w; oZ += n.z * w; nO++;
        }

        if (nO > 0) {
          diX = oX; diY = oY; diZ = oZ;
          urgent = true;
        } else {
          // ---- Niveau 1 : fuite face au faucon ----
          let fled = false;
          if (predator.active) {
            const dpx = predator.x - xi, dpy = predator.y - yi, dpz = predator.z - zi;
            const dd = Math.hypot(dpx, dpy, dpz);
            if (dd < R_FEAR && dd > 1e-9) {
              const cosP = (vxi * dpx + vyi * dpy + vzi * dpz) / dd;
              if (cosP >= cosHalfAlpha) {
                diX = -dpx / dd; diY = -dpy / dd; diZ = -dpz / dd;
                fled = true;
                urgent = true;
              }
            }
          }

          // ---- Niveaux 2-3 : règles de Couzin (zor, zoo, zoa) ----
          if (!fled) {
            let nr = 0, no = 0, na = 0;
            let drX = 0, drY = 0, drZ = 0;
            let doX = 0, doY = 0, doZ = 0;
            let daX = 0, daY = 0, daZ = 0;

            for (let j = 0; j < N; j++) {
              if (i === j || !alive[j]) continue;
              const dx = posX[j] - xi, dy = posY[j] - yi, dz = posZ[j] - zi;
              const distSq = dx * dx + dy * dy + dz * dz;
              if (distSq > pr.ra_i * pr.ra_i) continue;
              const dist = Math.sqrt(distSq);
              let rijX, rijY, rijZ;
              if (dist > 1e-9) { rijX = dx / dist; rijY = dy / dist; rijZ = dz / dist; }
              else { rijX = 1; rijY = 0; rijZ = 0; }

              if (dist < pr.rr_i) {
                // Éq. (1) : zone de répulsion, sphère complète
                drX -= rijX; drY -= rijY; drZ -= rijZ;
                nr++;
              } else if (nr === 0) {
                // Champ de perception α (cône aveugle arrière)
                const cosAngle = vxi * rijX + vyi * rijY + vzi * rijZ;
                if (cosAngle >= cosHalfAlpha) {
                  if (dist < pr.ro_i) {
                    // Éq. (2) : zone d'orientation
                    doX += velX[j]; doY += velY[j]; doZ += velZ[j];
                    no++;
                  } else {
                    // Éq. (3) : zone d'attraction
                    daX += rijX; daY += rijY; daZ += rijZ;
                    na++;
                  }
                }
              }
            }

            if (nr > 0) {
              diX = drX; diY = drY; diZ = drZ;
            } else if (no > 0 && na === 0) {
              diX = doX; diY = doY; diZ = doZ;
            } else if (na > 0 && no === 0) {
              diX = daX; diY = daY; diZ = daZ;
            } else if (no > 0 && na > 0) {
              diX = 0.5 * (doX + daX); diY = 0.5 * (doY + daY); diZ = 0.5 * (doZ + daZ);
            } else {
              diX = vxi; diY = vyi; diZ = vzi;
            }
          }
        }

        // Normalisation (vecteur nul -> on garde v_i(t))
        const nrm = Math.hypot(diX, diY, diZ);
        if (nrm < 1e-8) { diX = vxi; diY = vyi; diZ = vzi; }
        else { diX /= nrm; diY /= nrm; diZ /= nrm; }

        // Erreur stochastique (gaussienne sphérique d'écart-type σ)
        if (pr.sigma_i > 0) {
          const p = perturbDirection(diX, diY, diZ, randomStandardNormal() * pr.sigma_i);
          diX = p.x; diY = p.y; diZ = p.z;
        }

        // Rotation maximale θτ (multipliée en urgence)
        const turnDeg = pr.theta_i * (urgent ? URGENT_TURN : 1);
        const maxRad = turnDeg * Math.PI / 180 * TAU;
        const t = turnLimited(vxi, vyi, vzi, diX, diY, diZ, maxRad);
        nextVelX[i] = t.x; nextVelY[i] = t.y; nextVelZ[i] = t.z;
      }

      // 2) Intégration : c_i(t+τ) = c_i(t) + v_i(t+τ) s_i τ, puis contraintes environnementales
      for (let i = 0; i < N; i++) {
        if (!alive[i]) continue;
        const pr = getIndividualParams(i);
        velX[i] = nextVelX[i]; velY[i] = nextVelY[i]; velZ[i] = nextVelZ[i];
        posX[i] += velX[i] * pr.s_i * TAU;
        posY[i] += velY[i] * pr.s_i * TAU;
        posZ[i] += velZ[i] * pr.s_i * TAU;
        const r = resolveEnvironment(posX[i], posY[i], posZ[i]);
        posX[i] = r.x; posY[i] = r.y; posZ[i] = r.z;
      }

      stepPredator();

      stepCount++;
      computeGlobalMetrics();
      pushTrailPositions();

      if (hysteresis.active) {
        updateHysteresisStep();
      } else {
        timeHistory.push({ p: pGroup, m: mGroup });
        if (timeHistory.length > MAX_HISTORY) timeHistory.shift();
      }
    }

    // ========================================================================
    // 8. FAUCON
    // ========================================================================
    function spawnPredator() {
      const ang = Math.random() * TWO_PI;
      predator.x = cGroup.x + Math.cos(ang) * 60;
      predator.z = cGroup.z + Math.sin(ang) * 60;
      predator.y = Math.max(cGroup.y + 8, floorAt(predator.x, predator.z) + 10);
      predator.px = predator.x; predator.py = predator.y; predator.pz = predator.z;
      predator.vx = -Math.cos(ang); predator.vy = -0.05; predator.vz = -Math.sin(ang);
      const n = Math.hypot(predator.vx, predator.vy, predator.vz);
      predator.vx /= n; predator.vy /= n; predator.vz /= n;
      predator.cooldown = 0;
      predator.active = true;
    }

    function captureBird(i) {
      alive[i] = 0;
      captures++;
      spawnFeathers(posX[i], posY[i], posZ[i]);
      predator.cooldown = PRED_COOLDOWN;
    }

    function stepPredator() {
      if (!predator.active) return;
      const N = params.N;
      predator.px = predator.x; predator.py = predator.y; predator.pz = predator.z;
      const px = predator.x, py = predator.y, pz = predator.z;
      let target = -1;
      let dX, dY, dZ;

      if (predator.cooldown > 0) {
        // Repos : s'éloigne et remonte
        predator.cooldown--;
        dX = px - cGroup.x; dY = (py - cGroup.y) + 5; dZ = pz - cGroup.z;
      } else {
        // Cible : oiseau vivant le plus proche
        let best = Infinity;
        for (let i = 0; i < N; i++) {
          if (!alive[i]) continue;
          const d2 = (posX[i] - px) ** 2 + (posY[i] - py) ** 2 + (posZ[i] - pz) ** 2;
          if (d2 < best) { best = d2; target = i; }
        }
        if (target >= 0) { dX = posX[target] - px; dY = posY[target] - py; dZ = posZ[target] - pz; }
        else { dX = cGroup.x - px; dY = cGroup.y - py; dZ = cGroup.z - pz; }
      }
      const nn = Math.hypot(dX, dY, dZ) || 1;
      dX /= nn; dY /= nn; dZ /= nn;

      const t = turnLimited(predator.vx, predator.vy, predator.vz, dX, dY, dZ, PRED_TURN * Math.PI / 180 * TAU);
      predator.vx = t.x; predator.vy = t.y; predator.vz = t.z;

      predator.x += predator.vx * params.predSpeed * TAU;
      predator.y += predator.vy * params.predSpeed * TAU;
      predator.z += predator.vz * params.predSpeed * TAU;
      const r = resolveEnvironment(predator.x, predator.y, predator.z);
      predator.x = r.x; predator.y = r.y; predator.z = r.z;

      if (target >= 0 && predator.cooldown === 0) {
        const d = Math.hypot(posX[target] - predator.x, posY[target] - predator.y, posZ[target] - predator.z);
        if (d < PRED_CAPTURE_R) captureBird(target);
      }
    }

    // ========================================================================
    // 9. MÉTRIQUES GLOBALES (Éq. 4, 5, 6, 7) & CLASSES D'ÉQUIVALENCE
    // ========================================================================
    function computeGlobalMetrics() {
      const N = params.N;
      let n = 0, cx = 0, cy = 0, cz = 0, sx = 0, sy = 0, sz = 0;
      for (let i = 0; i < N; i++) {
        if (!alive[i]) continue;
        n++;
        cx += posX[i]; cy += posY[i]; cz += posZ[i];
        sx += velX[i]; sy += velY[i]; sz += velZ[i];
      }
      nAlive = n;
      if (n === 0) { pGroup = 0; mGroup = 0; numClusters = 0; return; }

      cx /= n; cy /= n; cz /= n;
      cGroup.set(cx, cy, cz);
      dGroup.set(sx / n, sy / n, sz / n);

      // Éq. (4) : p_group = |(1/N) Σ v_i|
      pGroup = dGroup.length();

      // Éq. (5) : m_group = (1/N) |Σ r_ic × v_i| avec r_ic unitaire -> [0, 1]
      let mx = 0, my = 0, mz = 0;
      for (let i = 0; i < N; i++) {
        if (!alive[i]) continue;
        let rx = posX[i] - cx, ry = posY[i] - cy, rz = posZ[i] - cz;
        const rl = Math.hypot(rx, ry, rz);
        if (rl > 1e-8) {
          rx /= rl; ry /= rl; rz /= rl;
          mx += ry * velZ[i] - rz * velY[i];
          my += rz * velX[i] - rx * velZ[i];
          mz += rx * velY[i] - ry * velX[i];
        }
      }
      mGroup = Math.hypot(mx, my, mz) / n;

      if (stepCount % 5 === 0 || stepCount <= 1) computeEquivalenceClasses();
      else cameraFollowTarget.copy(cGroup);
    }

    const visited = new Uint8Array(MAX_N);
    function computeEquivalenceClasses() {
      const N = params.N;
      const cosHalfAlpha = Math.cos((params.alpha * Math.PI) / 360.0);
      visited.fill(0);
      for (let i = 0; i < N; i++) if (!alive[i]) visited[i] = 1;

      let clusters = 0;
      let largest = [];
      for (let start = 0; start < N; start++) {
        if (visited[start]) continue;
        clusters++;
        const queue = [start];
        visited[start] = 1;
        const members = [start];
        while (queue.length > 0) {
          const u = queue.pop();
          const pu = getIndividualParams(u);
          for (let v = 0; v < N; v++) {
            if (visited[v]) continue;
            const dx = posX[v] - posX[u], dy = posY[v] - posY[u], dz = posZ[v] - posZ[u];
            const d = Math.hypot(dx, dy, dz);
            const pv = getIndividualParams(v);
            let connected = d < Math.max(pu.rr_i, pv.rr_i);
            if (!connected && d > 1e-8) {
              const dotU = (velX[u] * dx + velY[u] * dy + velZ[u] * dz) / d;
              const dotV = -(velX[v] * dx + velY[v] * dy + velZ[v] * dz) / d;
              if ((d <= pu.ra_i && dotU >= cosHalfAlpha) || (d <= pv.ra_i && dotV >= cosHalfAlpha)) connected = true;
            }
            if (connected) { visited[v] = 1; queue.push(v); members.push(v); }
          }
        }
        if (members.length > largest.length) largest = members;
      }

      numClusters = clusters;
      if (clusters > 1 && largest.length > 0) {
        let lx = 0, ly = 0, lz = 0;
        for (const idx of largest) { lx += posX[idx]; ly += posY[idx]; lz += posZ[idx]; }
        cameraFollowTarget.set(lx / largest.length, ly / largest.length, lz / largest.length);
      } else {
        cameraFollowTarget.copy(cGroup);
      }
    }

    // ========================================================================
    // 10. SCÈNE THREE.JS : RENDU, CIEL, LUMIÈRES, CAMÉRA
    // ========================================================================
    const canvas = document.getElementById('three-canvas');
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;

    const scene = new THREE.Scene();

    const skyMat = new THREE.ShaderMaterial({
      side: THREE.BackSide,
      depthWrite: false,
      uniforms: {
        topColor: { value: new THREE.Color(0x0c2448) },
        midColor: { value: new THREE.Color(0x1e4d7b) },
        horizonColor: { value: new THREE.Color(0x7ca5c8) },
        bottomColor: { value: new THREE.Color(0x182638) }
      },
      vertexShader: `
        varying vec3 vWorldDir;
        void main() {
          vWorldDir = normalize(position);
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform vec3 topColor; uniform vec3 midColor; uniform vec3 horizonColor; uniform vec3 bottomColor;
        varying vec3 vWorldDir;
        void main() {
          float h = vWorldDir.y;
          vec3 col;
          if (h >= 0.0) {
            col = mix(horizonColor, midColor, smoothstep(0.0, 0.35, h));
            col = mix(col, topColor, smoothstep(0.35, 0.9, h));
          } else {
            col = mix(horizonColor, bottomColor, smoothstep(0.0, -0.45, h));
          }
          gl_FragColor = vec4(col, 1.0);
        }
      `
    });
    const skyDome = new THREE.Mesh(new THREE.SphereGeometry(800, 32, 24), skyMat);
    scene.add(skyDome);

    const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.2, 1500);
    camera.position.set(18, 14, 22);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.07;
    controls.minDistance = 4;
    controls.maxDistance = 220;

    const hemiLight = new THREE.HemisphereLight(0xdbeafe, 0x334155, 1.15);
    scene.add(hemiLight);
    const sunLight = new THREE.DirectionalLight(0xfff7ed, 1.8);
    sunLight.position.set(35, 60, 25);
    scene.add(sunLight);

    // Particules d'air (perception de la vitesse s)
    const DUST_COUNT = 700;
    const DUST_BOX = 90;
    const dustPositions = new Float32Array(DUST_COUNT * 3);
    for (let i = 0; i < DUST_COUNT * 3; i++) dustPositions[i] = (Math.random() - 0.5) * DUST_BOX;
    const dustGeo = new THREE.BufferGeometry();
    dustGeo.setAttribute('position', new THREE.BufferAttribute(dustPositions, 3));
    const dustPoints = new THREE.Points(dustGeo, new THREE.PointsMaterial({ color: 0xe0f2fe, size: 0.22, transparent: true, opacity: 0.4 }));
