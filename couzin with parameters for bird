      const oldN = params.N;
      params.N = parseInt(e.target.value, 10);
      if (params.N > oldN) initFlock(false);
      syncUIFromParams();
    });
    document.getElementById('inp-rr').addEventListener('input', (e) => { params.rr = parseFloat(e.target.value); syncUIFromParams(); });
    document.getElementById('inp-dro').addEventListener('input', (e) => { params.dro = parseFloat(e.target.value); syncUIFromParams(); });
    document.getElementById('inp-dra').addEventListener('input', (e) => { params.dra = parseFloat(e.target.value); syncUIFromParams(); });
    document.getElementById('inp-alpha').addEventListener('input', (e) => { params.alpha = parseFloat(e.target.value); syncUIFromParams(); });
    document.getElementById('inp-theta').addEventListener('input', (e) => { params.theta = parseFloat(e.target.value); syncUIFromParams(); });
    document.getElementById('inp-s').addEventListener('input', (e) => { params.s = parseFloat(e.target.value); syncUIFromParams(); });
    document.getElementById('inp-sigma').addEventListener('input', (e) => { params.sigma = parseFloat(e.target.value); syncUIFromParams(); });
    document.getElementById('inp-simspeed').addEventListener('input', (e) => { params.simSpeed = parseFloat(e.target.value); syncUIFromParams(); });

    // Tri spatial
    const sortSlider = document.getElementById('inp-sort-sd');
    document.getElementById('sel-sorting').addEventListener('change', (e) => {
      params.sortParam = e.target.value;
      if (params.sortParam === 's') { sortSlider.min = 0.02; sortSlider.max = 0.25; sortSlider.step = 0.01; params.sortSD = 0.15; }
      else if (params.sortParam === 'rr') { sortSlider.min = 0.02; sortSlider.max = 0.30; sortSlider.step = 0.01; params.sortSD = 0.20; }
      else if (params.sortParam === 'theta') { sortSlider.min = 0.5; sortSlider.max = 8.0; sortSlider.step = 0.5; params.sortSD = 5.0; }
      else if (params.sortParam === 'ro') { sortSlider.min = 0.2; sortSlider.max = 2.5; sortSlider.step = 0.1; params.sortSD = 1.5; }
      else if (params.sortParam === 'sigma') { sortSlider.min = 0.01; sortSlider.max = 0.08; sortSlider.step = 0.005; params.sortSD = 0.04; }
      sortSlider.value = params.sortSD;
      document.getElementById('lbl-sort-sd').textContent = params.sortSD;
      syncUIFromParams();
    });
    sortSlider.addEventListener('input', (e) => {
      params.sortSD = parseFloat(e.target.value);
      document.getElementById('lbl-sort-sd').textContent = params.sortSD;
    });

    // Cases à cocher
    document.getElementById('chk-follow').addEventListener('change', (e) => { params.followGroup = e.target.checked; });
    document.getElementById('chk-trails').addEventListener('change', (e) => {
      params.showTrails = e.target.checked;
      trailLines.visible = params.showTrails;
    });
    document.getElementById('chk-plane').addEventListener('change', (e) => {
      params.showGroupPlane = e.target.checked;
      groupPlaneGroup.visible = params.showGroupPlane;
    });
    document.getElementById('chk-zones').addEventListener('change', (e) => {
      params.showBirdZones = e.target.checked;
      birdZonesGroup.visible = params.showBirdZones;
      updateBirdColors();
    });

    // Pause et réinitialisation
    document.getElementById('btn-pause').addEventListener('click', (e) => {
      params.paused = !params.paused;
      e.target.textContent = params.paused ? '▶ Reprendre' : '⏸ Pause';
    });
    document.getElementById('btn-reset').addEventListener('click', () => {
      if (hysteresis.active) stopHysteresisExperiment();
      hysteresis.upPoints = []; hysteresis.downPoints = [];
      document.getElementById('chart-mode-label').textContent = 'Temps réel';
      initFlock(true);
      updateEnvStats();
    });

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // ========================================================================
    // 20. DÉMARRAGE
    // ========================================================================
    syncUIFromParams();
    seedOff = Math.random() * 400;
    buildEnvironment();
    applyBiomeVisuals();
    rebuildObstacleFlat();
    initFlock(true);
    lastCameraFollow.copy(cGroup);
    controls.target.copy(cGroup);
    updateEnvStats();
    requestAnimationFrame(animate);
  </script>
</body>
</html>
