        -0.05, 0.04, 0.16, 0.065, 0.045, -0.08, 0.05, 0.04, 0.16,
        0.05, 0.04, 0.16, 0.065, 0.045, -0.08, 0.00, -0.06, -0.06,
        0.05, 0.04, 0.16, 0.00, -0.06, -0.06, 0.00, -0.05, 0.16,
        -0.05, 0.04, 0.16, 0.00, -0.05, 0.16, 0.00, -0.06, -0.06,
        -0.05, 0.04, 0.16, 0.00, -0.06, -0.06, -0.065, 0.045, -0.08,
