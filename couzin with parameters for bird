    document.getElementById('btn-predator').addEventListener('click', () => {
      if (predator.active) {
        predator.active = false;
      } else {
        spawnPredator();
      }
      refreshPredatorButton();
      updateEnvStats();
    });

    document.getElementById('btn-obstacle').addEventListener('click', () => {
      addUserObstacle();
    });

