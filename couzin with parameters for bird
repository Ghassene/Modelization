    function createWingGeometry(sign) {
      const s = sign;
      const pts = [
        [0.03 * s, 0.03, 0.12], [0.22 * s, 0.04, 0.04], [0.03 * s, 0.02, -0.10],
        [0.03 * s, 0.02, -0.10], [0.22 * s, 0.04, 0.04], [0.19 * s, 0.02, -0.12],
        [0.22 * s, 0.04, 0.04], [0.44 * s, 0.01, -0.14], [0.19 * s, 0.02, -0.12],
        [0.03 * s, 0.025, 0.12], [0.03 * s, 0.015, -0.10], [0.22 * s, 0.035, 0.04],
        [0.03 * s, 0.015, -0.10], [0.19 * s, 0.015, -0.12], [0.22 * s, 0.035, 0.04],
        [0.22 * s, 0.035, 0.04], [0.19 * s, 0.015, -0.12], [0.44 * s, 0.005, -0.14]
      ];
      const arr = new Float32Array(pts.length * 3);
      pts.forEach((p, i) => { arr[i * 3] = p[0]; arr[i * 3 + 1] = p[1]; arr[i * 3 + 2] = p[2]; });
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geo.computeVertexNormals();
      return geo;
    }

    const birdMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.45, metalness: 0.08 });
    const bodyInstanced = new THREE.InstancedMesh(createBirdBodyGeometry(), birdMat, MAX_N);
    const wingRInstanced = new THREE.InstancedMesh(createWingGeometry(1), birdMat, MAX_N);
    const wingLInstanced = new THREE.InstancedMesh(createWingGeometry(-1), birdMat, MAX_N);
    [bodyInstanced, wingRInstanced, wingLInstanced].forEach(m => { m.frustumCulled = false; scene.add(m); });

    // Faucon : plus grand, plumage sombre
    const predGroup = new THREE.Group();
    predGroup.visible = false;
    const hawkMat = new THREE.MeshStandardMaterial({ color: 0x4a3322, roughness: 0.55 });
    const hawkBody = new THREE.InstancedMesh(createBirdBodyGeometry(), hawkMat, 1);
    const hawkWingR = new THREE.InstancedMesh(createWingGeometry(1), hawkMat, 1);
    const hawkWingL = new THREE.InstancedMesh(createWingGeometry(-1), hawkMat, 1);
    [hawkBody, hawkWingR, hawkWingL].forEach(m => { m.frustumCulled = false; predGroup.add(m); });
    scene.add(predGroup);

    const zeroMatrix = new THREE.Matrix4().makeScale(0, 0, 0);
    const _rot = new THREE.Matrix4(), _roll = new THREE.Matrix4(), _body = new THREE.Matrix4();
    const _scale = new THREE.Matrix4(), _wm = new THREE.Matrix4(), _wRot = new THREE.Matrix4();

    // Écrit la matrice d'un oiseau (corps + ailes) : +Z = direction de vol
    function writeBirdMatrices(body, wr, wl, idx, px, py, pz, dir, bank, flap, scale) {
      const upRef = Math.abs(dir.y) > 0.98 ? ALT_UP : WORLD_UP;
      _rot.lookAt(dir, ZERO_VEC, upRef);
      _roll.makeRotationZ(bank);
      _body.multiplyMatrices(_rot, _roll);
      if (scale !== 1) { _scale.makeScale(scale, scale, scale); _body.multiply(_scale); }
      _body.setPosition(px, py, pz);
      body.setMatrixAt(idx, _body);

      _wRot.makeRotationZ(flap);
      _wm.multiplyMatrices(_body, _wRot);
      wr.setMatrixAt(idx, _wm);
      _wRot.makeRotationZ(-flap);
      _wm.multiplyMatrices(_body, _wRot);
      wl.setMatrixAt(idx, _wm);
    }

    const sortColorA = new THREE.Color(0x2563eb), sortColorB = new THREE.Color(0x06b6d4);
    const sortColorC = new THREE.Color(0xfde047), sortColorD = new THREE.Color(0xef4444);
    function valueToSortColor(t01, target) {
      const t = Math.max(0, Math.min(1, t01));
      if (t < 0.33) target.copy(sortColorA).lerp(sortColorB, t / 0.33);
      else if (t < 0.66) target.copy(sortColorB).lerp(sortColorC, (t - 0.33) / 0.33);
      else target.copy(sortColorC).lerp(sortColorD, (t - 0.66) / 0.34);
      return target;
    }

    function updateBirdColors() {
      const tmp = new THREE.Color();
      for (let i = 0; i < MAX_N; i++) {
        if (params.showBirdZones && i === lastZoneIdx) tmp.setHex(0xf43f5e);
        else if (params.sortParam === 'none') {
          const shade = 0.82 + 0.16 * (0.5 + 0.5 * Math.sin(i * 2.1));
          tmp.setRGB(shade * 0.92, shade * 0.95, shade);
        } else {
          valueToSortColor((indivZScore[i] + 2.2) / 4.4, tmp);
        }
        bodyInstanced.setColorAt(i, tmp);
        wingRInstanced.setColorAt(i, tmp);
        wingLInstanced.setColorAt(i, tmp);
      }
      bodyInstanced.instanceColor.needsUpdate = true;
      wingRInstanced.instanceColor.needsUpdate = true;
      wingLInstanced.instanceColor.needsUpdate = true;
    }

    // ========================================================================
    // 12. AIDES VISUELLES : SILLAGES, PLAN FRONTAL, ZONES, PLUMES
    // ========================================================================
    const TRAIL_LEN = 16;
    const trailHistory = new Float32Array(MAX_N * TRAIL_LEN * 3);
    const trailSegmentsPos = new Float32Array(MAX_N * (TRAIL_LEN - 1) * 2 * 3);
    const trailSegmentsCol = new Float32Array(MAX_N * (TRAIL_LEN - 1) * 2 * 3);
    const trailGeo = new THREE.BufferGeometry();
    trailGeo.setAttribute('position', new THREE.BufferAttribute(trailSegmentsPos, 3));
    trailGeo.setAttribute('color', new THREE.BufferAttribute(trailSegmentsCol, 3));
    const trailLines = new THREE.LineSegments(trailGeo, new THREE.LineBasicMaterial({ vertexColors: true, transparent: true, opacity: 0.42 }));
    trailLines.frustumCulled = false;
    scene.add(trailLines);

    function resetTrails() {
      for (let i = 0; i < MAX_N; i++) {
        for (let k = 0; k < TRAIL_LEN; k++) {
          const b = (i * TRAIL_LEN + k) * 3;
          trailHistory[b] = posX[i]; trailHistory[b + 1] = posY[i]; trailHistory[b + 2] = posZ[i];
        }
      }
    }

    function pushTrailPositions() {
      const N = params.N;
      for (let i = 0; i < N; i++) {
        for (let k = TRAIL_LEN - 1; k > 0; k--) {
          const dst = (i * TRAIL_LEN + k) * 3, src = (i * TRAIL_LEN + (k - 1)) * 3;
          trailHistory[dst] = trailHistory[src];
          trailHistory[dst + 1] = trailHistory[src + 1];
          trailHistory[dst + 2] = trailHistory[src + 2];
        }
        const head = i * TRAIL_LEN * 3;
        trailHistory[head] = posX[i]; trailHistory[head + 1] = posY[i]; trailHistory[head + 2] = posZ[i];
      }
      if (!params.showTrails) return;

      let ptr = 0;
      const tmpC = new THREE.Color();
      for (let i = 0; i < N; i++) {
        const isAlive = alive[i] === 1;
        if (params.sortParam === 'none') tmpC.setHex(0x7dd3fc);
        else valueToSortColor((indivZScore[i] + 2.2) / 4.4, tmpC);
        for (let k = 0; k < TRAIL_LEN - 1; k++) {
          const a = (i * TRAIL_LEN + k) * 3;
          const b = isAlive ? (i * TRAIL_LEN + k + 1) * 3 : a; // oiseau capturé : segment nul
          const fadeA = isAlive ? 1.0 - k / TRAIL_LEN : 0;
          const fadeB = isAlive ? 1.0 - (k + 1) / TRAIL_LEN : 0;
          trailSegmentsPos[ptr] = trailHistory[a]; trailSegmentsPos[ptr + 1] = trailHistory[a + 1]; trailSegmentsPos[ptr + 2] = trailHistory[a + 2];
          trailSegmentsCol[ptr] = tmpC.r * fadeA; trailSegmentsCol[ptr + 1] = tmpC.g * fadeA; trailSegmentsCol[ptr + 2] = tmpC.b * fadeA;
          ptr += 3;
          trailSegmentsPos[ptr] = trailHistory[b]; trailSegmentsPos[ptr + 1] = trailHistory[b + 1]; trailSegmentsPos[ptr + 2] = trailHistory[b + 2];
          trailSegmentsCol[ptr] = tmpC.r * fadeB; trailSegmentsCol[ptr + 1] = tmpC.g * fadeB; trailSegmentsCol[ptr + 2] = tmpC.b * fadeB;
          ptr += 3;
        }
      }
      trailGeo.setDrawRange(0, ptr / 3);
      trailGeo.attributes.position.needsUpdate = true;
      trailGeo.attributes.color.needsUpdate = true;
    }

    // Figure 2 : c_group, d_group et plan frontal
    const groupPlaneGroup = new THREE.Group();
    groupPlaneGroup.visible = false;
    const cSphere = new THREE.Mesh(new THREE.SphereGeometry(0.32, 16, 16), new THREE.MeshBasicMaterial({ color: 0xfacc15 }));
    const planeMesh = new THREE.Mesh(new THREE.PlaneGeometry(18, 18),
      new THREE.MeshBasicMaterial({ color: 0xfacc15, transparent: true, opacity: 0.14, side: THREE.DoubleSide, depthWrite: false }));
    const planeBorder = new THREE.LineSegments(new THREE.EdgesGeometry(new THREE.PlaneGeometry(18, 18)),
      new THREE.LineBasicMaterial({ color: 0xfde047, transparent: true, opacity: 0.5 }));
    const dArrow = new THREE.ArrowHelper(new THREE.Vector3(0, 0, 1), new THREE.Vector3(), 6, 0xfacc15, 1.1, 0.6);
    groupPlaneGroup.add(cSphere, planeMesh, planeBorder, dArrow);
    scene.add(groupPlaneGroup);

    // Figure 1 : zor, zoo, zoa et angle mort
    const birdZonesGroup = new THREE.Group();
    birdZonesGroup.visible = false;
    const sphereWireGeo = new THREE.SphereGeometry(1, 20, 14);
    const zorMesh = new THREE.Mesh(sphereWireGeo, new THREE.MeshBasicMaterial({ color: 0xf43f5e, wireframe: true, transparent: true, opacity: 0.5 }));
    const zooMesh = new THREE.Mesh(sphereWireGeo, new THREE.MeshBasicMaterial({ color: 0x38bdf8, wireframe: true, transparent: true, opacity: 0.25 }));
    const zoaMesh = new THREE.Mesh(sphereWireGeo, new THREE.MeshBasicMaterial({ color: 0x4ade80, wireframe: true, transparent: true, opacity: 0.14 }));
    const blindConeGeo = new THREE.ConeGeometry(1, 1, 28, 1, true);
    blindConeGeo.translate(0, -0.5, 0);
    blindConeGeo.rotateX(Math.PI / 2);
    const blindConeMesh = new THREE.Mesh(blindConeGeo,
      new THREE.MeshBasicMaterial({ color: 0x0f172a, transparent: true, opacity: 0.48, side: THREE.DoubleSide, depthWrite: false }));
    birdZonesGroup.add(zorMesh, zooMesh, zoaMesh, blindConeMesh);
    scene.add(birdZonesGroup);

    function syncBirdZonesVisual(pos0, dir0, idx) {
      if (!params.showBirdZones || idx < 0) return;
      birdZonesGroup.position.copy(pos0);
      const pr = getIndividualParams(idx);
      zorMesh.scale.setScalar(pr.rr_i);
      zooMesh.scale.setScalar(pr.ro_i);
      zoaMesh.scale.setScalar(pr.ra_i);
      const m = new THREE.Matrix4().lookAt(dir0, ZERO_VEC, WORLD_UP);
      birdZonesGroup.quaternion.setFromRotationMatrix(m);
      const halfBlind = ((360 - params.alpha) * 0.5 * Math.PI) / 180.0;
      if (halfBlind <= 0.01) {
        blindConeMesh.visible = false;
      } else {
        blindConeMesh.visible = true;
        const coneLen = pr.ra_i * Math.cos(halfBlind);
        const coneRad = pr.ra_i * Math.sin(halfBlind);
        blindConeMesh.scale.set(coneRad, coneRad, Math.max(0.05, coneLen));
      }
    }

    // Plumes (capture)
    const FEATHER_N = 160;
    const featherPos = new Float32Array(FEATHER_N * 3);
    const featherVel = new Float32Array(FEATHER_N * 3);
    const featherLife = new Float32Array(FEATHER_N);
    let featherPtr = 0;
    for (let i = 0; i < FEATHER_N; i++) featherPos[i * 3 + 1] = -9999;
    const featherGeo = new THREE.BufferGeometry();
    featherGeo.setAttribute('position', new THREE.BufferAttribute(featherPos, 3));
    const featherPoints = new THREE.Points(featherGeo,
      new THREE.PointsMaterial({ color: 0xf5f5f4, size: 0.3, transparent: true, opacity: 0.9, depthWrite: false }));
    featherPoints.frustumCulled = false;
    scene.add(featherPoints);

    function spawnFeathers(x, y, z) {
      for (let k = 0; k < 18; k++) {
        const idx = featherPtr;
        featherPtr = (featherPtr + 1) % FEATHER_N;
        featherPos[idx * 3] = x; featherPos[idx * 3 + 1] = y; featherPos[idx * 3 + 2] = z;
        featherVel[idx * 3] = (Math.random() - 0.5) * 4;
        featherVel[idx * 3 + 1] = Math.random() * 2;
        featherVel[idx * 3 + 2] = (Math.random() - 0.5) * 4;
        featherLife[idx] = 1.5;
      }
    }
    function updateFeathers(dt) {
      let any = false;
      for (let idx = 0; idx < FEATHER_N; idx++) {
        if (featherLife[idx] <= 0) continue;
        featherLife[idx] -= dt;
        featherVel[idx * 3 + 1] -= 3 * dt;
        for (let c = 0; c < 3; c++) featherPos[idx * 3 + c] += featherVel[idx * 3 + c] * dt;
        if (featherLife[idx] <= 0) featherPos[idx * 3 + 1] = -9999;
        any = true;
      }
      if (any) featherGeo.attributes.position.needsUpdate = true;
    }

    // ========================================================================
    // 13. ENVIRONNEMENTS : RELIEF, EAU, VÉGÉTATION
    // ========================================================================
    const envGroup = new THREE.Group();
    scene.add(envGroup);

    const PALETTES = {
      forest:   { stops: [[-5, 0x2d4f2a], [3, 0x2f5d2a], [10, 0x3f6f35], [18, 0x5c6b3a]], rock: 0x6b5a48, rockSlope: 0.8 },
      lake:     { stops: [[-20, 0x8a7a4e], [-0.5, 0xc9b67e], [1.5, 0xa5b05e], [6, 0x5f8a3a], [18, 0x4a7a34]], rock: 0x7a7060, rockSlope: 0.75 },
      mountain: { stops: [[0, 0x4f6b3a], [14, 0x6b7a45], [32, 0x8a7d6a], [46, 0xe8eef5], [70, 0xffffff]], rock: 0x6e6a66, rockSlope: 0.72 },
      plain:    { stops: [[-5, 0x9aa35a], [3, 0xb8a852], [8, 0xc9a85c]], rock: 0x8b7b5b, rockSlope: 0.8 }
    };
    const _c1 = new THREE.Color(), _c2 = new THREE.Color(), _rockC = new THREE.Color();
    function terrainColor(h, ny, out) {
      const P = PALETTES[currentBiome];
      const st = P.stops;
      if (h <= st[0][0]) out.setHex(st[0][1]);
      else if (h >= st[st.length - 1][0]) out.setHex(st[st.length - 1][1]);
      else {
        for (let k = 0; k < st.length - 1; k++) {
          if (h >= st[k][0] && h <= st[k + 1][0]) {
            const t = (h - st[k][0]) / (st[k + 1][0] - st[k][0]);
            _c1.setHex(st[k][1]); _c2.setHex(st[k + 1][1]);
            out.copy(_c1).lerp(_c2, t);
            break;
          }
        }
      }
      const rockT = THREE.MathUtils.clamp((P.rockSlope - ny) / 0.2, 0, 1);
      if (rockT > 0) { _rockC.setHex(P.rock); out.lerp(_rockC, rockT); }
    }

    function buildTerrain() {
      const size = 600, seg = 160;
      const geo = new THREE.PlaneGeometry(size, size, seg, seg);
      geo.rotateX(-Math.PI / 2);
      const pos = geo.attributes.position;
      for (let i = 0; i < pos.count; i++) pos.setY(i, groundRaw(pos.getX(i), pos.getZ(i)));
      geo.computeVertexNormals();
      const normals = geo.attributes.normal;
      const colors = new Float32Array(pos.count * 3);
      const col = new THREE.Color();
      for (let i = 0; i < pos.count; i++) {
        terrainColor(pos.getY(i), normals.getY(i), col);
        colors[i * 3] = col.r; colors[i * 3 + 1] = col.g; colors[i * 3 + 2] = col.b;
      }
      geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      const mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ vertexColors: true, roughness: 0.95, metalness: 0 }));
      envGroup.add(mesh);
    }

    function buildWater() {
      const mat = new THREE.MeshStandardMaterial({ color: 0x1f6f9e, roughness: 0.08, metalness: 0.25, transparent: true, opacity: 0.92 });
      const water = new THREE.Mesh(new THREE.CircleGeometry(48, 72), mat);
      water.rotation.x = -Math.PI / 2;
      water.position.y = 0.03;
      envGroup.add(water);
    }

    function buildVegetation() {
      const trunkGeo = new THREE.CylinderGeometry(0.3, 0.45, 1, 6); trunkGeo.translate(0, 0.5, 0);
      const pineGeo = new THREE.ConeGeometry(1, 1, 7); pineGeo.translate(0, 0.5, 0);
      const sphereGeo = new THREE.SphereGeometry(1, 10, 7);
      const rockGeo = new THREE.IcosahedronGeometry(1, 1);
      const trunkMat = new THREE.MeshStandardMaterial({ color: 0x5a4330, roughness: 1 });
      const pineMat = new THREE.MeshStandardMaterial({ color: 0x1f4d2b, roughness: 0.9, flatShading: true });
      const leafMat = new THREE.MeshStandardMaterial({ color: 0x6b8f2e, roughness: 0.85, flatShading: true });
      const rockMat = new THREE.MeshStandardMaterial({ color: 0x7d7770, roughness: 0.95, flatShading: true });

      const trunks = [], pines = [], leaves = [], rocks = [];
      const add = (arr, px, py, pz, sx, sy, sz) => {
        const m = new THREE.Matrix4();
        m.compose(new THREE.Vector3(px, py, pz), new THREE.Quaternion(), new THREE.Vector3(sx, sy, sz));
        arr.push(m);
      };
      const rnd = (a, b) => a + Math.random() * (b - a);

      if (currentBiome === 'forest' || currentBiome === 'lake' || currentBiome === 'plain') {
        const count = { forest: 300, lake: 110, plain: 70 }[currentBiome];
        const span = { forest: 190, lake: 120, plain: 200 }[currentBiome];
        let placed = 0, tries = 0;
        while (placed < count && tries < count * 8) {
          tries++;
          let x, z;
          if (currentBiome === 'lake') {
            const a = Math.random() * TWO_PI, r = rnd(50, span);
            x = Math.cos(a) * r; z = Math.sin(a) * r;
          } else {
            x = rnd(-span, span); z = rnd(-span, span);
          }
          if (Math.hypot(x, z) < 12) continue;   // zone de départ dégagée
          const g = groundH(x, z);
          if (currentBiome === 'lake' && (g < 1.2 || g > 12)) continue; // rives uniquement
          if (currentBiome === 'plain' && g < 0) continue;

          if (currentBiome === 'plain') {
            const H = rnd(5, 7);
            add(trunks, x, g, z, 1, 0.6 * H, 1);
            add(leaves, x, g + 0.6 * H, z, 2.2, 0.6, 2.2);
            envObstacles.push({ ax: x, ay: g, az: z, bx: x, by: g + 0.6 * H, bz: z, R: 0.8 });
          } else {
            const H = rnd(7, 12);
            add(trunks, x, g, z, 1, 0.5 * H, 1);
            add(pines, x, g + 0.45 * H, z, 0.18 * H, 0.6 * H, 0.18 * H);
            envObstacles.push({ ax: x, ay: g, az: z, bx: x, by: g + 0.6 * H, bz: z, R: 0.9 });
          }
          placed++;
        }
      }

      if (currentBiome === 'mountain') {
        let placed = 0;
        for (let t = 0; placed < 110 && t < 900; t++) {
          const x = rnd(-200, 200), z = rnd(-200, 200);
          if (Math.hypot(x, z) < 14) continue;
          const g = groundH(x, z);
          const r = rnd(1.2, 3.8);
          const cy = g + r * 0.2;
          add(rocks, x, cy, z, r, r * 0.8, r);
          envObstacles.push({ ax: x, ay: cy, az: z, bx: x, by: cy, bz: z, R: r * 0.85 });
          placed++;
        }
      }

      const addInst = (geo, mat, arr) => {
        if (arr.length === 0) return;
        const im = new THREE.InstancedMesh(geo, mat, arr.length);
        arr.forEach((m, i) => im.setMatrixAt(i, m));
        im.instanceMatrix.needsUpdate = true;
        envGroup.add(im);
      };
      addInst(trunkGeo, trunkMat, trunks);
      addInst(pineGeo, pineMat, pines);
      addInst(sphereGeo, leafMat, leaves);
      addInst(rockGeo, rockMat, rocks);
    }

    function clearEnvironment() {
      while (envGroup.children.length) {
        const c = envGroup.children[0];
        envGroup.remove(c);
        c.traverse(o => {
          if (o.geometry) o.geometry.dispose();
          if (o.material) o.material.dispose();
        });
      }
    }

    function buildEnvironment() {
      clearEnvironment();
      envObstacles = [];
      if (currentBiome === 'none') return;
      buildTerrain();
      if (currentBiome === 'lake') buildWater();
      buildVegetation();
    }

    function applyBiomeVisuals() {
      const S = BIOME_SETTINGS[currentBiome];
      skyMat.uniforms.topColor.value.setHex(S.sky[0]);
      skyMat.uniforms.midColor.value.setHex(S.sky[1]);
      skyMat.uniforms.horizonColor.value.setHex(S.sky[2]);
      skyMat.uniforms.bottomColor.value.setHex(S.sky[3]);
      scene.fog = S.fog ? new THREE.FogExp2(S.fog[0], S.fog[1]) : null;
    }

    // ========================================================================
    // 14. OBSTACLES AJOUTÉS PAR L'UTILISATEUR
    // ========================================================================
    const userObsGroup = new THREE.Group();
    scene.add(userObsGroup);
    const obsMat = new THREE.MeshStandardMaterial({ color: 0xf472b6, emissive: 0x3b0a24, roughness: 0.4 });

    function addUserObstacle() {
      if (userObstacles.length >= OBS_MAX) return;
      let dX = dGroup.x, dZ = dGroup.z;
      let L = Math.hypot(dX, dZ);
      if (L < 0.2) { const a = Math.random() * TWO_PI; dX = Math.cos(a); dZ = Math.sin(a); L = 1; }
      dX /= L; dZ /= L;
      const lat = (Math.random() - 0.5) * 18;
      const dist = 24 + Math.random() * 8;
      const x = cGroup.x + dX * dist - dZ * lat;
      const z = cGroup.z + dZ * dist + dX * lat;

      let o, mesh;
      if (Math.random() < 0.5) {
        // Pylône
        const R = 1.3, H = 18;
        const g = floorAt(x, z);
        o = { ax: x, ay: g, az: z, bx: x, by: g + H, bz: z, R };
        mesh = new THREE.Mesh(new THREE.CylinderGeometry(R, R, H, 14), obsMat);
        mesh.position.set(x, g + H / 2, z);
      } else {
        // Ballon / rocher en altitude
        const R = 2.5 + Math.random() * 2;
        const y = Math.max(cGroup.y + (Math.random() - 0.5) * 10, floorAt(x, z) + R + 1);
        o = { ax: x, ay: y, az: z, bx: x, by: y, bz: z, R };
        mesh = new THREE.Mesh(new THREE.SphereGeometry(R, 20, 14), obsMat);
        mesh.position.set(x, y, z);
      }
      userObstacles.push(o);
      userObsGroup.add(mesh);
      rebuildObstacleFlat();
      updateEnvStats();
    }

    function clearUserObstacles() {
      for (const m of [...userObsGroup.children]) {
        userObsGroup.remove(m);
        m.geometry.dispose();
      }
      userObstacles = [];
      rebuildObstacleFlat();
      updateEnvStats();
    }

    // ========================================================================
    // 15. CHANGEMENT D'ENVIRONNEMENT
    // ========================================================================
    function setBiome(name) {
      if (hysteresis.active) stopHysteresisExperiment();
      currentBiome = name;
      document.getElementById('sel-biome').value = name;
      seedOff = Math.random() * 400;
      clearUserObstacles();
      buildEnvironment();
      applyBiomeVisuals();
      rebuildObstacleFlat();
      initFlock(false);
      updateEnvStats();
    }

    // ========================================================================
    // 16. PROTOCOLE D'HYSTÉRÉSIS (Fig. 4)
    // ========================================================================
    function startHysteresisExperiment() {
      predator.active = false;
      predGroup.visible = false;
      if (currentBiome !== 'none') setBiome('none');
      else clearUserObstacles();

      params.N = 100; params.rr = 1.0; params.alpha = 270; params.theta = 40; params.s = 3.0; params.sigma = 0.05;
      params.sortParam = 'none';
      params.simSpeed = 6.0;

      hysteresis.active = true;
      hysteresis.direction = 1;
      hysteresis.roCurrent = 1.0;
      hysteresis.stepsAtValue = 0;
      hysteresis.upPoints = [];
      hysteresis.downPoints = [];

      applyRoWithFixedRa14(1.0);
      syncUIFromParams();
      initFlock(false);
      document.getElementById('btn-hysteresis').textContent = '⏹ Arrêter le protocole d\'Hystérésis';
      document.getElementById('chart-mode-label').textContent = 'Courbe en ro (Hystérésis)';
      updateEnvStats();
    }

    function stopHysteresisExperiment() {
      hysteresis.active = false;
      document.getElementById('btn-hysteresis').textContent = '▶ Lancer le cycle d\'Hystérésis (ro : 1 → 4.5 → 1)';
      document.getElementById('hysteresis-status').textContent = 'Cycle terminé ou interrompu. Le graphe conserve l\'historique.';
    }

    function applyRoWithFixedRa14(roVal) {
      params.rr = 1.0;
      params.dro = Math.max(0, roVal - 1.0);
      params.dra = Math.max(0, 14.0 - roVal);
    }

    function updateHysteresisStep() {
      hysteresis.stepsAtValue++;
      const statusEl = document.getElementById('hysteresis-status');
      const phaseTxt = hysteresis.direction > 0 ? 'Croissance ↑' : 'Décroissance ↓';
      statusEl.textContent = `${phaseTxt} : ro = ${hysteresis.roCurrent.toFixed(2)} (ra = 14 fixe) — pas ${hysteresis.stepsAtValue}/${hysteresis.stepsPerIncrement}`;

      if (hysteresis.stepsAtValue >= hysteresis.stepsPerIncrement) {
        const pt = { ro: hysteresis.roCurrent, p: pGroup, m: mGroup };
        if (hysteresis.direction > 0) hysteresis.upPoints.push(pt);
        else hysteresis.downPoints.push(pt);

        hysteresis.stepsAtValue = 0;
        if (hysteresis.direction > 0) {
          hysteresis.roCurrent = Math.round((hysteresis.roCurrent + 0.25) * 100) / 100;
          if (hysteresis.roCurrent > 4.5) { hysteresis.direction = -1; hysteresis.roCurrent = 4.5; }
        } else {
          hysteresis.roCurrent = Math.round((hysteresis.roCurrent - 0.25) * 100) / 100;
          if (hysteresis.roCurrent < 1.0) {
            stopHysteresisExperiment();
            statusEl.textContent = 'Hystérésis complète ! Notez l\'absence de Tore au retour (pointillés).';
            return;
          }
        }
        applyRoWithFixedRa14(hysteresis.roCurrent);
        syncUIFromParams();
      }
    }

    // ========================================================================
    // 17. GRAPHE 2D
    // ========================================================================
    const chartCanvas = document.getElementById('chart-canvas');
    const ctx = chartCanvas.getContext('2d');

    function drawChart() {
      const W = chartCanvas.width, H = chartCanvas.height;
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = 'rgba(255,255,255,0.07)';
      ctx.lineWidth = 1;
      for (let g = 0.25; g < 1.0; g += 0.25) {
        const y = H - g * (H - 14) - 7;
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
      }

      if (hysteresis.active || hysteresis.upPoints.length > 1) {
        const xOfRo = (ro) => 12 + ((ro - 1.0) / 3.5) * (W - 24);
        const yOfVal = (v) => H - 8 - v * (H - 18);
        const drawCurve = (pts, color, dashed) => {
          if (pts.length === 0) return;
          ctx.save();
          ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = 2;
          if (dashed) ctx.setLineDash([4, 3]);
          ctx.beginPath();
          pts.forEach((pt, idx) => {
            const x = xOfRo(pt.ro), y = yOfVal(pt.val);
            if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
          });
          ctx.stroke();
          pts.forEach(pt => { ctx.beginPath(); ctx.arc(xOfRo(pt.ro), yOfVal(pt.val), 2.3, 0, TWO_PI); ctx.fill(); });
          ctx.restore();
        };
        drawCurve(hysteresis.upPoints.map(d => ({ ro: d.ro, val: d.p })), '#38bdf8', false);
        drawCurve(hysteresis.upPoints.map(d => ({ ro: d.ro, val: d.m })), '#fb923c', false);
        drawCurve(hysteresis.downPoints.map(d => ({ ro: d.ro, val: d.p })), '#7dd3fc', true);
        drawCurve(hysteresis.downPoints.map(d => ({ ro: d.ro, val: d.m })), '#fdba74', true);
        if (hysteresis.active) {
          const cx = xOfRo(hysteresis.roCurrent);
          ctx.strokeStyle = 'rgba(255,255,255,0.35)';
          ctx.beginPath(); ctx.moveTo(cx, 0); ctx.lineTo(cx, H); ctx.stroke();
        }
      } else {
        if (timeHistory.length < 2) return;
        const stepX = W / (MAX_HISTORY - 1);
        const yOfVal = (v) => H - 6 - v * (H - 12);
        ctx.lineWidth = 1.8;
        ctx.strokeStyle = '#38bdf8';
        ctx.beginPath();
        timeHistory.forEach((pt, idx) => { const x = idx * stepX, y = yOfVal(pt.p); if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y); });
        ctx.stroke();
        ctx.strokeStyle = '#fb923c';
        ctx.beginPath();
        timeHistory.forEach((pt, idx) => { const x = idx * stepX, y = yOfVal(pt.m); if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y); });
        ctx.stroke();
      }
    }

    // ========================================================================
    // 18. BOUCLE D'ANIMATION
    // ========================================================================
    const tmpPos = new THREE.Vector3();
    const tmpDir = new THREE.Vector3();
    const tmpPredPos = new THREE.Vector3();
    const tmpPredDir = new THREE.Vector3();
    const interpCentroid = new THREE.Vector3();
    const lastCameraFollow = new THREE.Vector3();

    let accumulator = 0;
    let lastTime = performance.now();

    function animate(now) {
      requestAnimationFrame(animate);
      const dtReal = Math.min(0.05, (now - lastTime) / 1000);
      lastTime = now;

      if (!params.paused) {
        accumulator += dtReal * params.simSpeed;
        let sub = 0;
        while (accumulator >= TAU && sub < 15) {
          stepSimulation();
          accumulator -= TAU;
          sub++;
        }
      }

      const alphaInterp = params.paused ? 1.0 : Math.max(0, Math.min(1, accumulator / TAU));
      const N = params.N;

      // Premier oiseau vivant : référence pour l'affichage Fig. 1
      let zoneIdx = -1;
      for (let i = 0; i < N; i++) if (alive[i]) { zoneIdx = i; break; }
      if (zoneIdx !== lastZoneIdx) { lastZoneIdx = zoneIdx; updateBirdColors(); }

      for (let i = 0; i < MAX_N; i++) {
        if (i >= N || !alive[i]) {
          bodyInstanced.setMatrixAt(i, zeroMatrix);
          wingRInstanced.setMatrixAt(i, zeroMatrix);
          wingLInstanced.setMatrixAt(i, zeroMatrix);
          continue;
        }
        tmpPos.set(
          prevPosX[i] + (posX[i] - prevPosX[i]) * alphaInterp,
          prevPosY[i] + (posY[i] - prevPosY[i]) * alphaInterp,
          prevPosZ[i] + (posZ[i] - prevPosZ[i]) * alphaInterp
        );
        tmpDir.set(
          prevVelX[i] + (velX[i] - prevVelX[i]) * alphaInterp,
          prevVelY[i] + (velY[i] - prevVelY[i]) * alphaInterp,
          prevVelZ[i] + (velZ[i] - prevVelZ[i]) * alphaInterp
        ).normalize();

        // Roulis visuel dans les virages
        const crossY = prevVelZ[i] * velX[i] - prevVelX[i] * velZ[i];
        const targetBank = Math.max(-0.65, Math.min(0.65, -crossY * 6.5));
        indivBank[i] += (targetBank - indivBank[i]) * Math.min(1, dtReal * 8);

        if (!params.paused) {
          const pr = getIndividualParams(i);
          indivPhase[i] += dtReal * (7.5 + pr.s_i * 1.4) * Math.min(2.5, params.simSpeed);
        }
        const flap = 0.58 * Math.sin(indivPhase[i]) + 0.10 * Math.cos(2 * indivPhase[i]);
        writeBirdMatrices(bodyInstanced, wingRInstanced, wingLInstanced, i,
          tmpPos.x, tmpPos.y, tmpPos.z, tmpDir, indivBank[i], flap, 1);

        if (i === zoneIdx && params.showBirdZones) syncBirdZonesVisual(tmpPos, tmpDir, i);
      }
      bodyInstanced.instanceMatrix.needsUpdate = true;
      wingRInstanced.instanceMatrix.needsUpdate = true;
      wingLInstanced.instanceMatrix.needsUpdate = true;

      // Faucon
      predGroup.visible = predator.active;
      if (predator.active) {
        const a = alphaInterp;
        tmpPredPos.set(
          predator.px + (predator.x - predator.px) * a,
          predator.py + (predator.y - predator.py) * a,
          predator.pz + (predator.z - predator.pz) * a
        );
        tmpPredDir.set(predator.vx, predator.vy, predator.vz).normalize();
        if (!params.paused) predator.phase += dtReal * (6 + params.predSpeed) * Math.min(2.5, params.simSpeed);
        const flapP = 0.5 * Math.sin(predator.phase);
        writeBirdMatrices(hawkBody, hawkWingR, hawkWingL, 0,
          tmpPredPos.x, tmpPredPos.y, tmpPredPos.z, tmpPredDir, 0, flapP, 1.9);
        hawkBody.instanceMatrix.needsUpdate = true;
        hawkWingR.instanceMatrix.needsUpdate = true;
        hawkWingL.instanceMatrix.needsUpdate = true;
      }

      updateFeathers(dtReal);

      // Caméra : suivi fluide du centre (ou du plus grand sous-groupe)
      interpCentroid.lerpVectors(prevCGroup, cGroup, alphaInterp);
      if (params.followGroup) {
        const desired = numClusters > 1 ? cameraFollowTarget : interpCentroid;
        const delta = new THREE.Vector3().subVectors(desired, lastCameraFollow);
        if (delta.lengthSq() < 400) {
          const step = delta.multiplyScalar(Math.min(1, dtReal * 10));
          camera.position.add(step);
          controls.target.add(step);
          lastCameraFollow.add(step);
        } else {
          lastCameraFollow.copy(desired);
          controls.target.copy(desired);
        }
      } else {
        lastCameraFollow.copy(controls.target);
      }

      skyDome.position.copy(camera.position);

      // Recyclage des particules d'air autour de la cible
      const posAttr = dustGeo.attributes.position;
      const halfBox = DUST_BOX * 0.5;
      for (let i = 0; i < DUST_COUNT; i++) {
        let changed = false;
        let x = posAttr.getX(i), y = posAttr.getY(i), z = posAttr.getZ(i);
        let dx = x - controls.target.x, dy = y - controls.target.y, dz = z - controls.target.z;
        if (dx > halfBox) { posAttr.setX(i, x - DUST_BOX); changed = true; } else if (dx < -halfBox) { posAttr.setX(i, x + DUST_BOX); changed = true; }
        if (dy > halfBox) { posAttr.setY(i, y - DUST_BOX); changed = true; } else if (dy < -halfBox) { posAttr.setY(i, y + DUST_BOX); changed = true; }
        if (dz > halfBox) { posAttr.setZ(i, z - DUST_BOX); changed = true; } else if (dz < -halfBox) { posAttr.setZ(i, z + DUST_BOX); changed = true; }
        if (changed) posAttr.needsUpdate = true;
      }

      if (params.showGroupPlane) {
        groupPlaneGroup.position.copy(interpCentroid);
        const dLen = dGroup.length();
        if (dLen > 1e-4) {
          const dirNorm = dGroup.clone().normalize();
          planeMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), dirNorm);
          planeBorder.quaternion.copy(planeMesh.quaternion);
          dArrow.setDirection(dirNorm);
          dArrow.setLength(4.0 + 4.0 * dLen, 1.0, 0.55);
        }
      }

      controls.update();

      // La caméra ne passe jamais sous le relief
      const gCam = floorAt(camera.position.x, camera.position.z) + 1.5;
      if (camera.position.y < gCam) camera.position.y = gCam;

      updateHUD();
      drawChart();
      renderer.render(scene, camera);
    }

    // ========================================================================
    // 19. INTERFACE UTILISATEUR
    // ========================================================================
    function updateEnvStats() {
      const el = document.getElementById('env-stats');
      if (!el) return;
      let predTxt = 'absent';
      if (predator.active) predTxt = predator.cooldown > 0 ? 'actif (repos après capture)' : 'actif — en chasse';
      el.innerHTML =
        `Oiseaux vivants : <b>${nAlive}</b> / ${params.N} &nbsp;·&nbsp; Captures : <b>${captures}</b><br>` +
        `Faucon : ${predTxt}<br>` +
        `Obstacles : ${envObstacles.length} de décor &nbsp;·&nbsp; ${userObstacles.length} ajouté(s)`;
      refreshPredatorButton();
    }

    function refreshPredatorButton() {
      document.getElementById('btn-predator').textContent = predator.active ? '🦅 Retirer le faucon' : '🦅 Ajouter un faucon';
    }

    function updateHUD() {
      document.getElementById('val-p').textContent = pGroup.toFixed(3);
      document.getElementById('val-m').textContent = mGroup.toFixed(3);
      document.getElementById('bar-p').style.width = `${(pGroup * 100).toFixed(1)}%`;
      document.getElementById('bar-m').style.width = `${(mGroup * 100).toFixed(1)}%`;
      document.getElementById('time-info').textContent = `t = ${(stepCount * TAU).toFixed(1)} s (${stepCount} pas)`;

      const clEl = document.getElementById('val-clusters');
      if (numClusters <= 1) {
        clEl.textContent = '1 groupe (cohésif)';
        clEl.style.color = '#4ade80';
      } else {
        clEl.textContent = `${numClusters} sous-groupes (fragmenté)`;
        clEl.style.color = '#fb923c';
      }

      const badge = document.getElementById('state-badge');
      if (numClusters > 2) {
        badge.textContent = 'Groupe fragmenté';
        badge.style.borderColor = '#f87171'; badge.style.color = '#fca5a5';
      } else if (mGroup > 0.52 && pGroup < 0.45) {
        badge.textContent = 'Tore / Moulinet (Torus)';
        badge.style.borderColor = '#fb923c'; badge.style.color = '#fdba74';
      } else if (pGroup > 0.92) {
        badge.textContent = 'Vol hautement parallèle';
        badge.style.borderColor = '#38bdf8'; badge.style.color = '#7dd3fc';
      } else if (pGroup > 0.55) {
        badge.textContent = 'Vol parallèle dynamique';
        badge.style.borderColor = '#34d399'; badge.style.color = '#6ee7b7';
      } else {
        badge.textContent = 'Essaim (Swarm)';
        badge.style.borderColor = '#a78bfa'; badge.style.color = '#c4b5fd';
      }

      if (stepCount % 10 === 0) updateEnvStats();
    }

