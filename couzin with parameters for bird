
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Couzin et al. (2002) — Oiseaux, faucon, obstacles & environnements</title>
  <style>
    :root {
      --bg-panel: rgba(13, 19, 31, 0.84);
      --border: rgba(255, 255, 255, 0.12);
      --accent: #38bdf8;
      --accent-2: #fb923c;
      --text: #f1f5f9;
      --muted: #94a3b8;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      overflow: hidden;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: #0b132b;
      color: var(--text);
      user-select: none;
    }
    canvas#three-canvas { display: block; width: 100vw; height: 100vh; }

    .panel {
      position: fixed;
      background: var(--bg-panel);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.45);
      z-index: 10;
    }
    #hud-left { top: 14px; left: 14px; width: 320px; }
    h1 { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 2px; }
    .subtitle { font-size: 11px; color: var(--muted); margin-bottom: 12px; }
    .badge-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; gap: 8px; }
    .state-badge {
      padding: 3px 9px; border-radius: 999px; font-size: 11px; font-weight: 600;
      background: rgba(56, 189, 248, 0.2); border: 1px solid rgba(56, 189, 248, 0.5); color: #7dd3fc;
    }
    .time-info { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
    .metric { margin-bottom: 8px; }
    .metric-header { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 3px; font-variant-numeric: tabular-nums; }
    .bar-bg { width: 100%; height: 7px; background: rgba(255,255,255,0.08); border-radius: 4px; overflow: hidden; }
    .bar-fill { height: 100%; width: 0%; transition: width 0.1s linear; }
    #bar-p { background: linear-gradient(90deg, #0284c7, #38bdf8); }
    #bar-m { background: linear-gradient(90deg, #ea580c, #fb923c); }
    #chart-canvas {
      width: 100%; height: 115px; background: rgba(0,0,0,0.28);
      border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; margin-top: 6px; display: block;
    }
    .chart-legend { display: flex; justify-content: space-between; font-size: 10px; color: var(--muted); margin-top: 4px; }
    .env-stats { font-size: 11px; color: #cbd5e1; margin-top: 10px; line-height: 1.6; font-variant-numeric: tabular-nums; }

    #hud-right { top: 14px; right: 14px; width: 340px; max-height: calc(100vh - 28px); overflow-y: auto; }
    #hud-right::-webkit-scrollbar { width: 6px; }
    #hud-right::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 3px; }
    .section-title {
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--accent);
      margin: 12px 0 8px 0; padding-bottom: 4px; border-bottom: 1px solid rgba(255,255,255,0.08); font-weight: 700;
    }
    .section-title:first-child { margin-top: 0; }
    .hint { font-size: 10.5px; color: var(--muted); margin-top: 5px; line-height: 1.4; }

    .preset-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    button {
      background: rgba(255,255,255,0.08); color: var(--text); border: 1px solid rgba(255,255,255,0.15);
      border-radius: 6px; padding: 6px 8px; font-size: 11.5px; cursor: pointer; transition: all 0.15s ease; font-weight: 500;
    }
    button:hover { background: rgba(56,189,248,0.22); border-color: var(--accent); }
    button.active { background: rgba(56,189,248,0.32); border-color: var(--accent); color: #fff; }
    button.btn-warn { background: rgba(251,146,60,0.18); border-color: rgba(251,146,60,0.45); color: #fed7aa; }
    button.btn-warn:hover { background: rgba(251,146,60,0.35); }
    button.btn-danger { background: rgba(248,113,113,0.2); border-color: rgba(248,113,113,0.5); color: #fecaca; }
    button.btn-danger:hover { background: rgba(248,113,113,0.38); }

    .control-row { margin-bottom: 8px; }
    .control-label { display: flex; justify-content: space-between; font-size: 11.5px; margin-bottom: 2px; font-variant-numeric: tabular-nums; }
    .control-label span.val { color: var(--accent); font-weight: 600; }
    input[type="range"] { width: 100%; accent-color: var(--accent); height: 5px; cursor: pointer; }
    select {
      width: 100%; background: rgba(15,23,42,0.95); color: var(--text); border: 1px solid rgba(255,255,255,0.2);
      border-radius: 6px; padding: 5px 8px; font-size: 12px; margin-bottom: 6px; outline: none;
    }
    .gradient-bar { height: 8px; border-radius: 4px; background: linear-gradient(90deg, #2563eb, #06b6d4, #fde047, #ef4444); margin: 4px 0 2px 0; }
    .gradient-labels { display: flex; justify-content: space-between; font-size: 10px; color: var(--muted); }
    .checkbox-row { display: flex; align-items: center; gap: 8px; font-size: 11.5px; margin-bottom: 6px; cursor: pointer; }
    .checkbox-row input { accent-color: var(--accent); cursor: pointer; }
    .action-row { display: flex; gap: 6px; margin-top: 8px; }
    .action-row button { flex: 1; }
    #help-footer { bottom: 12px; left: 14px; padding: 8px 12px; font-size: 11px; color: var(--muted); }
  </style>

  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
        "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
      }
