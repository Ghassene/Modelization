  </script>
</head>
<body>

  <!-- HUD Gauche -->
  <div id="hud-left" class="panel">
    <h1>Couzin et al. (2002) — Nuée d'Oiseaux</h1>
    <div class="subtitle">Mémoire collective, tri spatial, faucon et obstacles (τ = 0.1 s)</div>

    <div class="badge-row">
      <span id="state-badge" class="state-badge">Vol Parallèle Dynamique</span>
      <span id="time-info" class="time-info">t = 0.0 s (0 pas)</span>
    </div>

    <div class="metric">
      <div class="metric-header">
        <span>Polarisation p<sub>group</sub> (Éq. 4)</span>
        <strong id="val-p" style="color:#38bdf8">0.000</strong>
      </div>
      <div class="bar-bg"><div id="bar-p" class="bar-fill"></div></div>
    </div>

    <div class="metric">
      <div class="metric-header">
        <span>Moment cinétique m<sub>group</sub> (Éq. 5)</span>
        <strong id="val-m" style="color:#fb923c">0.000</strong>
      </div>
      <div class="bar-bg"><div id="bar-m" class="bar-fill"></div></div>
