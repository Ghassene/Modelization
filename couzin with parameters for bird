      document.getElementById('inp-dro').value = params.dro;
      document.getElementById('lbl-dro').textContent = `${params.dro.toFixed(2)} (ro=${ro.toFixed(2)})`;
      document.getElementById('inp-dra').value = params.dra;
      document.getElementById('lbl-dra').textContent = `${params.dra.toFixed(2)} (ra=${ra.toFixed(2)})`;
      document.getElementById('inp-alpha').value = params.alpha;
      document.getElementById('lbl-alpha').textContent = `${params.alpha}°`;
      document.getElementById('inp-theta').value = params.theta;
      document.getElementById('lbl-theta').textContent = `${params.theta}°/s`;
      document.getElementById('inp-s').value = params.s;
      document.getElementById('lbl-s').textContent = params.s.toFixed(1);
      document.getElementById('inp-sigma').value = params.sigma;
      document.getElementById('lbl-sigma').textContent = `${params.sigma.toFixed(3)} rad`;
      document.getElementById('inp-simspeed').value = params.simSpeed;
      document.getElementById('lbl-simspeed').textContent = `${params.simSpeed.toFixed(1)}x`;
      document.getElementById('inp-predspeed').value = params.predSpeed;
      document.getElementById('lbl-predspeed').textContent = params.predSpeed.toFixed(1);
      document.getElementById('sel-sorting').value = params.sortParam;
      document.getElementById('sorting-controls').style.display = params.sortParam === 'none' ? 'none' : 'block';
      updateBirdColors();
    }

    function applyPreset(dro, dra) {
      if (hysteresis.active) stopHysteresisExperiment();
      hysteresis.upPoints = []; hysteresis.downPoints = [];
      document.getElementById('chart-mode-label').textContent = 'Temps réel';
      params.rr = 1.0; params.dro = dro; params.dra = dra;
      params.alpha = 270; params.theta = 40; params.s = 3.0; params.sigma = 0.05;
      syncUIFromParams();
    }

    document.getElementById('preset-swarm').addEventListener('click', () => applyPreset(0.25, 10.0));
    document.getElementById('preset-torus').addEventListener('click', () => applyPreset(1.0, 12.0));
    document.getElementById('preset-dynamic').addEventListener('click', () => applyPreset(5.0, 8.0));
    document.getElementById('preset-highly').addEventListener('click', () => applyPreset(12.0, 10.0));

    document.getElementById('btn-hysteresis').addEventListener('click', () => {
      if (hysteresis.active) stopHysteresisExperiment();
      else startHysteresisExperiment();
    });

